// Every task that runs a renderer goes through `apps/rtxtool/rtx <flavour>`, which owns the four
// build directories — `debug` -> build-debug, `asan` -> build-asan, `release` -> build-release,
// `nodlss` -> build-nodlss, with `profile.sh` on release — and configures each through
// CMakePresets.json. A task that ran cmake itself would be a second copy of all of it.
[
  {
    "label": "RTX: the game, on the quicksave (release)",
    "command": "cmake --build . -j32 --target openmw && ./openmw --skip-menu --load-savegame=\"$HOME/.local/share/openmw/saves/asd/Quicksave.omwsave\"",
    "cwd": "$ZED_WORKTREE_ROOT/build-release",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always",
    "tags": ["rtx-view"]
  },
  {
    "label": "RTX: seyda-neen-ship (release)",
    "command": "apps/rtxtool/rtx release view --size=2560x1440 --view=seyda-neen-ship",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always",
    "tags": ["rtx-view"]
  },
  // The Fullrest Repack under /home/Games/M[FR]: `~/.config/openmw-mfr` is its Linux profile, and
  // `--replace=config` keeps the vanilla profile's content list out of it.
  {
    "label": "RTX: seyda-neen-ship, M[FR] (release)",
    "command": "apps/rtxtool/rtx release view --size=2560x1440 --view=seyda-neen-ship --replace=config --config=\"$HOME/.config/openmw-mfr\"",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always",
    "tags": ["rtx-view"]
  },
  // Nivalis, a Tamriel Rebuilt town the M[FR] profile carries. `--weather` is set over the region
  // the town stands in, so no region id is named here.
  {
    "label": "RTX: Nivalis in snow, M[FR] (release)",
    "command": "apps/rtxtool/rtx release view --size=2560x1440 --cell=Nivalis --weather=Snow --replace=config --config=\"$HOME/.config/openmw-mfr\"",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always",
    "tags": ["rtx-view"]
  },
  // Vanilla content under the PBR retextures in /home/Games/Morrowind-PBR/mods, which
  // `~/.config/openmw-pbr` stacks in load order over that folder's `Data Files`.
  {
    "label": "RTX: seyda-neen-ship, PBR mods (release)",
    "command": "apps/rtxtool/rtx release view --size=2560x1440 --view=seyda-neen-ship --replace=config --config=\"$HOME/.config/openmw-pbr\"",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": true,
    "reveal": "always",
    "tags": ["rtx-view"]
  },
  {
    "label": "Build: everything",
    "command": "cmake --build . -j32",
    "cwd": "$ZED_WORKTREE_ROOT/build-debug",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Test: RTX only",
    "command": "apps/rtxtool/rtx debug test",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Test: everything",
    "command": "cmake --build . -j32 --target components-tests openmw-tests && ./components-tests && ./openmw-tests",
    "cwd": "$ZED_WORKTREE_ROOT/build-debug",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]
