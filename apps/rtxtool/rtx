#!/usr/bin/env bash
# The one way in: a build flavour, then what to do with it.
#
#   rtx <flavour> build [targets]        configure where the presets changed, then build the harness,
#                                        the game and the tests where the build has them, or the
#                                        targets named
#   rtx <flavour> test [gtest args]      components-tests Rtx* Sky* Crash*, the crash matrix,
#                                        rtx-gpu-tests, then openmw-tests Rtx*; `--without-device`
#                                        leaves the GPU binary out, for a box with no driver
#   rtx <flavour> game [args]            openmw on the quicksave
#   rtx <flavour> setup <morrowind dir>  write the openmw.cfg a fresh box has none of
#   rtx <flavour> repeat [--pairs=N] [bench args]
#                                        two runs of one binary walk one place and must agree
#   rtx <flavour> kernels [--against=<file>]
#                                        one digest per shader and tuple of its constants; against
#                                        an earlier listing, which tuples moved
#   rtx package archive [name]           the release archive out of the package build, into dist/:
#                                        an AppImage on Linux, the portable folder on Windows,
#                                        named after the ref or the name given, and its symbols
#   rtx package crash <dump> [symbols]   a player's crash dump, every thread named and lined,
#                                        against a release's -symbols.zip or the newest in dist/
#   rtx <flavour> gate                   clang-format 14, build, the release and no-DLSS compiles, test,
#                                        check, repeat — stops at the first failure
#   rtx <flavour> <verb> [args]          openmw-rtxtool <verb>, under the flavour's validation
#
#   flavour   directory          what it is
#   debug     build-debug        -O2 -g with every assert, the layers on with synchronization
#                                validation: the everyday build
#   release   build-release      -O3 -DNDEBUG, no layers, line tables and frame pointers so perf can
#                                name a line: the build a number is quoted from
#   asan      build-asan         debug under AddressSanitizer; `LSAN=1` turns the leak check back on
#   nodlss    build-nodlss       debug with -DOPENMW_RTX_DLSS=OFF: the other binary, whose upscaler
#                                refuses every mode by name and whose DLSS test skips
#   package   build-package      release with the launcher, the wizard and the importers, in the
#                                portable layout a release archive holds; `build` builds it all
#
# **One grammar for five builds**, because three scripts carried three: one had verbs only, one
# had tests by default and `tool` in front of a verb, and none built the game. What differed
# between them is the table above, and everything else is the same eight lines.
#
# **How each flavour is configured is `CMakePresets.json`'s**, at the root, in the form CMake and
# every IDE read: a flavour on a system is the preset `<flavour>-<system>`, and the reasons stand
# beside each variable there. What this script adds is what a preset cannot say — which system it
# is on and what that system lacks, what each flavour is for once built, and what a run is.
#
# **The verb stays first.** `dispatch` reads it off argv[1] and takes a leading dash to mean nobody
# named one, so a switch put before it silently ran `view` instead — a `bench` typed after them
# once opened a window and profiled nothing.
#
# **The same grammar under Git Bash on Windows, with MSVC.** Upstream's prebuilt dependency set is
# fetched into `deps/` the way `windows.yml` fetches it, and the compiler is found through vswhere
# and its environment captured into this shell. `rtx.cmd` beside this is what a Windows shell
# resolves `apps/rtxtool/rtx` to, and it starts this script in Git's bash — so an editor task
# names one command on both systems. The Vulkan SDK, CMake and Ninja are the installers' and stay
# on the PATH they put themselves on; `NGX_ROOT` names the checkout as it does anywhere. `asan` is
# refused: MSVC has a sanitizer, and nobody has measured this tree under it.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
# shellcheck source=apps/rtxtool/pins.sh
source "$root/apps/rtxtool/pins.sh"

# Bash's own word for the system it was built for, which no environment variable can misstate:
# `msys` under Git Bash, `linux-gnu` on the desk.
onWindows() {
    case "$OSTYPE" in
        msys* | cygwin*) return 0 ;;
        *) return 1 ;;
    esac
}

# The system's half of a preset's name.
if onWindows; then
    system=windows
else
    system=linux
fi

flavour="${1-}"
what="${2-}"
if [ -z "$flavour" ] || [ -z "$what" ]; then
    sed -n '2,/^# \*\*/{/^# \*\*/d; s/^# \{0,1\}//p}' "${BASH_SOURCE[0]}" >&2
    exit 2
fi
shift 2

# What a flavour is for once it is built: where it is, which layers a run of it takes, and which
# targets `build` builds by default. How it is configured is `CMakePresets.json`'s, under the
# same name — and so is whether it has tests, which `buildsTests` asks the build itself.
#
# A function, because the gate reaches for a second flavour: what a build without asserts compiles
# is a question the debug build cannot answer.
describeFlavour() {
    flavour="$1"
    build="$root/build-$flavour"
    validation=sync
    targets=(openmw-rtxtool openmw)
    case "$flavour" in
        debug | nodlss) ;;
        release)
            validation=off
            ;;
        asan)
            if onWindows; then
                echo "rtx: asan is Linux's here — MSVC's sanitizer has not been measured on this tree" >&2
                exit 2
            fi

            # **`protect_shadow_gap=0` is not a preference — without it there is no device at all.**
            # The NVIDIA driver maps its own enormous address ranges, ASan's shadow gap is mapped
            # `PROT_NONE` across part of what it wants, and `vkCreateDevice` comes back
            # `VK_ERROR_INITIALIZATION_FAILED`. Every RTX test then *skips*, which reads exactly like a
            # clean run. What it costs is the guard page that catches a wild pointer landing in the
            # gap; every other check ASan makes is untouched.
            #
            # **The driver's own allocations are not this fork's to answer for.** LeakSanitizer walks a
            # heap that the driver, the loader, the validation layers and dbus keep for the life of the
            # process, and reports each with a stack the fork does not appear in.
            options="protect_shadow_gap=0"
            if [ "${LSAN-0}" != 1 ]; then
                options="$options:detect_leaks=0"
            fi
            export ASAN_OPTIONS="$options${ASAN_OPTIONS:+:$ASAN_OPTIONS}"
            ;;
        package)
            validation=off
            targets=(all)
            ;;
        *)
            echo "rtx: no flavour is called '$flavour' — debug, release, asan, nodlss or package" >&2
            exit 2
            ;;
    esac
}

# **MSVC's environment, captured into this shell.** `cl` finds its headers and libraries through
# `INCLUDE` and `LIB`, which Ninja does not bake into the build, so every build needs them and not
# only the configure. `VsDevCmd.bat` sets them for the installation vswhere names, and `VSCMD_VER`
# is the documented sign that it already has. What is imported is the difference between two
# `declare -px` dumps taken inside the same `cmd`, one before the batch file and one after: the
# variables it set and nothing else, with MSYS's own conversion of the PATH. They are sourced as
# `export` lines, because a `declare` sourced inside a function declares locals. Each command in
# the `cmd` line starts with `call`, since `cmd /c` strips the quotes off a line that starts with
# one; vswhere's directory is on the PATH for it because the batch file looks for it there and
# says so when it cannot; and `-startdir=none` keeps `VSCMD_START_DIR` from moving the shell.
activateMsvc() {
    if [ -n "${VSCMD_VER-}" ]; then
        return
    fi

    local installer="/c/Program Files (x86)/Microsoft Visual Studio/Installer"
    if [ ! -x "$installer/vswhere.exe" ]; then
        echo "rtx: no Visual Studio installer at $installer, so no vswhere to find a compiler with" >&2
        exit 2
    fi

    local studio
    studio="$("$installer/vswhere.exe" -latest -products '*' \
        -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath)"
    if [ -z "$studio" ]; then
        echo "rtx: vswhere found no Visual Studio with the C++ tools" >&2
        exit 2
    fi

    local captured bash
    captured="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap "rm -rf '$captured'" RETURN
    bash="$(cygpath -w "$BASH")"
    PATH="$installer:$PATH" cmd //c \
        call "$bash" -c "declare -px > '$captured/before'" \
        "&&" call "$studio\\Common7\\Tools\\VsDevCmd.bat" -no_logo -arch=amd64 -host_arch=amd64 -startdir=none \
        "&&" call "$bash" -c "declare -px > '$captured/after'"

    comm -13 <(sort "$captured/before") <(sort "$captured/after") | sed 's/^declare -x /export /' > "$captured/changed"
    # shellcheck disable=SC1091
    source "$captured/changed"

    if [ -z "${VSCMD_VER-}" ] || ! command -v cl > /dev/null 2>&1; then
        echo "rtx: VsDevCmd.bat ran and left no compiler on the PATH" >&2
        exit 2
    fi
}

# **The tools every Windows fetch shares.** 7-Zip is the one tool the SDK installers do not
# bring, and it is looked for where its installer puts it; curl speaks TLS only.
sevenZip() {
    local found
    found="$(command -v 7z || echo "/c/Program Files/7-Zip/7z.exe")"
    if [ ! -x "$found" ]; then
        echo "rtx: the archives are .7z and NSIS, and there is no 7-Zip: \`winget install 7zip.7zip\`" >&2
        exit 2
    fi
    echo "$found"
}

fetch() {
    curl --proto '=https' --fail --location --silent --show-error --retry 3 "$@"
}

# A tool a step needs, asked for before the step starts anything, with the package that brings it.
require() {
    if ! command -v "$1" > /dev/null; then
        echo "rtx: $1 is not on the PATH, and this needs it: $2" >&2
        exit 2
    fi
}

# **One download, one checksum, one file**, for everything pinned here by SHA-256. Written beside
# its final name and given it only once the checksum has passed: a run cut off mid-way, or a
# mirror that served something else, leaves nothing a later run mistakes for the file.
fetchChecked() {
    local url="$1" sum="$2" file="$3"
    echo "fetching $(basename "$file")" >&2
    fetch --output "$file.partial" "$url"
    echo "$sum  $file.partial" | sha256sum --check --quiet --strict -
    mv "$file.partial" "$file"
}

# **Upstream's prebuilt dependency set, the way `windows.yml` gets it.** A manifest on
# `openmw-deps` names the archive and its SHA-512 for the tag `CI/deps_versions.msvc.sh` pins —
# the 2022 set, which upstream's own script links against Visual Studio 2026 as well. The
# archive is fetched, checked, and unpacked beside its final name, which it takes only once the
# whole of it is there: a run cut off mid-way leaves nothing a later run mistakes for a set.
fetchWindowsDeps() {
    if [ -d "$deps" ]; then
        return
    fi

    local unpack manifest
    unpack="$(sevenZip)"
    manifest="$(basename "$deps")-manifest.txt"
    mkdir -p "$root/deps"
    (
        cd "$root/deps"
        fetch --output "$manifest" "https://gitlab.com/OpenMW/openmw-deps/-/raw/main/windows/$manifest"
        local url archive
        url="$(sed -n '1p' "$manifest")"
        archive="$(sed -n '2p' "$manifest" | awk '{ print $2 }')"
        echo "fetching $archive" >&2
        fetch --output "$archive" "$url"
        # The second line alone: the first is the URL, which sha512sum would call malformed.
        sed -n '2p' "$manifest" | sha512sum --check --quiet --strict -
        rm -rf "$deps.partial"
        "$unpack" x -y -o"$deps.partial" "$archive" > /dev/null
        mv "$deps.partial" "$deps"
        rm -f "$archive"
    )
}

# **The formatter CI pins, out of LLVM's own Windows package.** Nothing installs clang-format 14
# on Windows any more — LLVM's current installer and the Visual Studio component both carry a
# later one, and the versions disagree — but LLVM still serves the last 14 package, an NSIS
# installer 7-Zip reads without running, and `bin/clang-format.exe` is one file of it. LLVM
# publishes a signature and no checksum for that release, so the SHA-256 `pins.sh` holds is the
# one taken off the download this was written against: the same bytes every time, and nothing else.
fetchClangFormat() {
    local found="$root/deps/clang-format-$llvmRelease/clang-format.exe"
    if [ -x "$found" ]; then
        echo "$found"
        return
    fi

    local unpack package="$root/deps/LLVM-$llvmRelease-win64.exe"
    unpack="$(sevenZip)"
    mkdir -p "$root/deps"
    fetchChecked "https://github.com/llvm/llvm-project/releases/download/llvmorg-$llvmRelease/$(basename "$package")" \
        "$llvmSha256" "$package"
    "$unpack" e -y -o"$(dirname "$found")" "$package" bin/clang-format.exe > /dev/null
    rm -f "$package"
    echo "$found"
}

# **SDL2 with Vulkan, from SDL's own release.** Upstream's prebuilt SDL2 is built without
# `SDL_VIDEO_VULKAN`, since the rasterizer never asks for a Vulkan surface, and the renderer's
# window is one: the symbols link and refuse at runtime. SDL's own Windows package of the same
# version carries it — the same version, because vcpkg's SDL2_image loads `SDL2.dll` by name and
# was built against that one. The version is read off the set and has to be the one `pins.sh`
# pins beside the package's checksum, which SDL does not publish: a bump upstream is a bump there.
# The preset reads the version through the environment, to name the package's directory.
fetchWindowsSdl() {
    local version="$RTX_SDL2_VERSION" sum="$sdl2Sha256"
    sdl="$root/deps/SDL2-$version"

    local stamp
    stamp="$(basename "$deps"/installed/vcpkg/info/sdl2_*_x64-windows.list)"
    if [ "$stamp" != "sdl2_${version}_x64-windows.list" ]; then
        echo "rtx: the dependency set carries $stamp and this script pins SDL2 $version" >&2
        exit 2
    fi
    if [ -d "$sdl" ]; then
        return
    fi

    local unpack package="$root/deps/SDL2-devel-$version-VC.zip"
    unpack="$(sevenZip)"
    fetchChecked "https://github.com/libsdl-org/SDL/releases/download/release-$version/$(basename "$package")" \
        "$sum" "$package"
    rm -rf "$sdl.partial"
    "$unpack" x -y -o"$sdl.partial" "$package" > /dev/null
    mv "$sdl.partial/SDL2-$version" "$sdl"
    rm -rf "$sdl.partial" "$package"
}

# **Qt, for the one flavour that builds the launcher and the wizard.** The dependency set carries
# none, so it comes the way `windows.yml` takes it: aqt, pinned by release and checksum, installs
# the version `CI/deps_versions.msvc.sh` names into deps/Qt, and the preset reads that version
# through `QT_VER`. Once, judged by the directory the install leaves.
fetchWindowsQt() {
    local version="${QT_VER:?}"
    qt="$root/deps/Qt/$version/msvc2019_64"
    if [ -d "$qt" ]; then
        return
    fi

    mkdir -p "$root/deps/Qt"
    fetchChecked "https://github.com/miurahr/aqtinstall/releases/download/$aqtRelease/aqt_x64.exe" "$aqtSha256" \
        "$root/deps/Qt/aqt_x64.exe"
    (cd "$root/deps/Qt" && ./aqt_x64.exe install-qt windows desktop "$version" win64_msvc2019_64)
    rm -f "$root/deps/Qt/aqt_x64.exe"
}

# **Everything a preset is expanded from**: the preset files, and the value of every environment
# variable they read. Two directories configured from equal digests were handed the same cache
# variables.
presetDigest() {
    local files=("$root/CMakePresets.json") name
    if [ -f "$root/CMakeUserPresets.json" ]; then
        files+=("$root/CMakeUserPresets.json")
    fi
    if grep -q '"include"' "${files[@]}"; then
        echo "rtx: a presets file includes another, which presetDigest does not read" >&2
        exit 2
    fi
    {
        cat "${files[@]}"
        for name in $(grep -ohE '\$p?env\{[A-Za-z_][A-Za-z0-9_]*\}' "${files[@]}" | sed -E 's/^\$p?env\{(.*)\}$/\1/' | sort -u); do
            printf '%s=%s\n' "$name" "${!name-}"
        done
    } | sha256sum | cut -d' ' -f1
}

# The build's CMake cache, an entry a line. CMake writes it in the platform's text mode, so on
# Windows every line ends in a carriage return, which comes off here.
cacheEntries() {
    tr -d '\r' < "$build/CMakeCache.txt"
}

# **Configured again whenever what its preset expands from changes, and from nothing else.** A
# directory configured once and never again keeps the cache it was first given, so a preset
# edited later never reached it: `build-release` went on building the tests its preset had since
# turned off. `rtx-preset.sha256` is the digest the directory was last configured from, written
# once a configure has succeeded, so a failed one is tried again rather than handed to ninja.
#
# **Fresh, and not the preset laid over the old cache**: a variable a preset stops naming would
# otherwise keep the value it last set, and the directory would be neither the old configuration
# nor the new one. The SDK is the one thing carried over, as every `NGX_` entry the cache holds a
# value in: `NGX_ROOT` where a `-D` named the checkout, and what `FindNGX` found with it, which is
# all that is left of a checkout the environment named once and does not name now.
#
# **Neither `--clean-first` nor `ninja -t cleandead`**: files/lang/*.ts are source that a Qt
# translation rule writes into the tree, so ninja logs them as outputs, and both delete them.
#
# What the platform supplies, and what each flavour asks, is the preset's to say. Windows's names
# the dependency set and SDL's package by version, through `VCPKG_TAG` and `RTX_SDL2_VERSION` in
# the environment, and both are fetched first.
configureIfNeeded() {
    local digest configuredFrom="$build/rtx-preset.sha256"
    digest="$(presetDigest)"
    if [ -f "$build/build.ninja" ] && [ "$(cat "$configuredFrom" 2> /dev/null)" = "$digest" ]; then
        return
    fi

    local carried=() entry
    if [ -f "$build/CMakeCache.txt" ]; then
        while IFS= read -r entry; do
            carried+=("-D$entry")
        done < <(cacheEntries | sed -nE '/^NGX_[A-Za-z_]*:(PATH|FILEPATH|STRING|UNINITIALIZED)=/{/-NOTFOUND$/d;p}')
    fi

    if onWindows; then
        fetchWindowsDeps
        fetchWindowsSdl
        if [ "$flavour" = package ]; then
            fetchWindowsQt
        fi
    fi

    cmake -S "$root" --preset "$flavour-$system" --fresh "${carried[@]}"

    if onWindows; then
        placeWindowsRuntime
        if [ "$flavour" = package ]; then
            placeWindowsQt
        fi
    fi

    echo "$digest" > "$configuredFrom"
}

# **What vcpkg's own copy step misses, placed the way upstream's MSVC script places it.** The
# toolchain copies each DLL a binary links beside it and stops there: MyGUI's sits a directory
# deeper than it looks and needs FreeType, which needs four more, and OSG's plugins are loaded by
# name at runtime from `osgPlugins-3.6.5/` beside the binary, which no link line names. The whole
# set, 84 MB, rather than a list that goes stale with the next tag.
placeWindowsRuntime() {
    local bin="$deps/installed/x64-windows/bin"
    cp "$bin"/*.dll "$bin/Release/MyGUIEngine.dll" "$build/"
    cp "$sdl/lib/x64/SDL2.dll" "$build/"
    mkdir -p "$build/osgPlugins-3.6.5"
    cp "$bin"/osgPlugins-3.6.5/*.dll "$build/osgPlugins-3.6.5/"
}

# **What the launcher and the wizard load, the list `windows.yml` places.** Qt's own deploy tool
# would bring the whole of what it guesses at; upstream's list is the seven libraries and four
# plugins the two programs reach, and the package installs every DLL the build directory holds.
placeWindowsQt() {
    local lib
    for lib in Core Gui Network OpenGL OpenGLWidgets Widgets Svg; do
        cp "$qt/bin/Qt6$lib.dll" "$build/"
    done
    mkdir -p "$build/styles" "$build/platforms" "$build/imageformats" "$build/iconengines"
    cp "$qt/plugins/styles/qwindowsvistastyle.dll" "$build/styles/"
    cp "$qt/plugins/platforms/qwindows.dll" "$build/platforms/"
    cp "$qt/plugins/imageformats/qsvg.dll" "$build/imageformats/"
    cp "$qt/plugins/iconengines/qsvgicon.dll" "$build/iconengines/"
}

describeFlavour "$flavour"
if onWindows; then
    activateMsvc
    # The tag upstream's own MSVC script reads the same way, and the set it names. Exported,
    # because the preset names the set by it too.
    # shellcheck disable=SC1091
    source "$root/CI/deps_versions.msvc.sh"
    export VCPKG_TAG="${VCPKG_TAG:?}"
    export QT_VER="${QT_VER:?}"
    deps="$root/deps/vcpkg-x64-windows-2022-$VCPKG_TAG"
fi
configureIfNeeded

# `-k 0` keeps ninja going past a failed object, so one run of a build that breaks names every
# object that broke — on a compiler this box does not have, that is the difference between one
# round trip through CI and five.
buildTargets() {
    cmake --build "$build" -j"$(nproc)" --target "$@" -- -k 0
}

# The value of one entry of the build's CMake cache, or nothing where the build has no cache yet.
cacheValue() {
    if [ -f "$build/CMakeCache.txt" ]; then
        cacheEntries | sed -n "s/^$1:[A-Z]*=\(.*\)$/\1/p"
    fi
}

testTargets=(components-tests crash-tests rtx-gpu-tests openmw-tests)

# **Whether this build has the tests, asked of its own build graph**: not of the flavour's name,
# and not of a binary on disk. A binary on disk is only what some earlier build left there, and a
# gate that ran one because it existed reported an earlier tree's tests as this tree's. Each
# binary is asked for, since two switches decide them, and a build that has some and not all is
# refused rather than tested in part. Asked of the Ninja the cache names, which is the one
# `cmake --build` runs, and refused outright where it names none: every caller asks inside an
# `if`, where `set -e` stops nothing and an empty answer would read as "no tests".
buildsTests() {
    local ninja target built=0
    ninja="$(cacheValue CMAKE_MAKE_PROGRAM)"
    if [ -z "$ninja" ]; then
        echo "rtx: $build/CMakeCache.txt names no CMAKE_MAKE_PROGRAM" >&2
        exit 2
    fi
    for target in "${testTargets[@]}"; do
        if "$ninja" -C "$build" -t query "$target" > /dev/null 2>&1; then
            built=$((built + 1))
        fi
    done
    if [ "$built" -ne 0 ] && [ "$built" -ne "${#testTargets[@]}" ]; then
        echo "rtx: the $flavour build has $built of the ${#testTargets[@]} test binaries —" \
            "its BUILD_COMPONENTS_TESTS and BUILD_OPENMW_TESTS disagree" >&2
        exit 2
    fi
    [ "$built" -ne 0 ]
}

addTestTargets() {
    if buildsTests; then
        targets+=("${testTargets[@]}")
    fi
}

# Where the game keeps its saves, and where it reads its own openmw.cfg and settings.cfg,
# answered the way `Files::LinuxPath` and `Files::WindowsPath` answer them: two directories on
# Linux, `XDG_DATA_HOME` or `~/.local/share` and `XDG_CONFIG_HOME` or `~/.config`, and one on
# Windows, the Documents folder the system names — which is not `~/Documents` on a box where
# OneDrive has moved it — under `My Games`.
userDataDir() {
    if onWindows; then
        userConfigDir
    else
        echo "${XDG_DATA_HOME:-$HOME/.local/share}/openmw"
    fi
}

userConfigDir() {
    if onWindows; then
        local documents
        documents="$(powershell -NoProfile -NonInteractive -Command "[Environment]::GetFolderPath('MyDocuments')")"
        echo "$(cygpath "$documents")/My Games/OpenMW"
    else
        echo "${XDG_CONFIG_HOME:-$HOME/.config}/openmw"
    fi
}

# A path as the game's own binaries take it: Windows spelling under Git Bash, the same path
# anywhere else.
nativePath() {
    if onWindows; then
        cygpath -w "$1"
    else
        echo "$1"
    fi
}

# **What upstream's wizard does, on a box with no Qt to run it.** A fresh box has no `openmw.cfg`
# and the harness stages no world until one names the game: `data=` says where `Data Files` is,
# and upstream's `openmw-iniimporter`, built here for the purpose, reads `Morrowind.ini` for the
# content files, the archives and the five hundred `fallback=` values the weather, the sky and
# the lighting are read from — without which the sky is black. The file is written where the
# game reads it, and never over one that is there: a box that has one has settings in it.
setupGame() {
    local install="${1-}"
    if [ ! -f "$install/Morrowind.ini" ] || [ ! -d "$install/Data Files" ]; then
        echo "rtx: setup takes the Morrowind directory — the one holding Morrowind.ini and Data Files" >&2
        exit 2
    fi

    local cfg
    cfg="$(userConfigDir)/openmw.cfg"
    if [ -e "$cfg" ]; then
        echo "rtx: $cfg is already there; move it away to start over" >&2
        exit 2
    fi

    cmake -DBUILD_MWINIIMPORTER=ON "$build" > /dev/null
    buildTargets openmw-iniimporter

    mkdir -p "$(dirname "$cfg")"
    printf 'data="%s"\n' "$(nativePath "$install/Data Files")" > "$cfg"
    (cd "$build" && ./openmw-iniimporter --game-files --encoding win1252 \
        "$(nativePath "$install/Morrowind.ini")" "$(nativePath "$cfg")")
    echo "wrote $cfg"
}

# The flavour's layers, unless the line names a level of its own: a typed level wins.
validationFor() {
    for arg in "$@"; do
        case "$arg" in
            --validation=*) return ;;
        esac
    done
    echo "--validation=$validation"
}

# **Every source in the working tree, and not every one git tracks.** CI's own script walks
# `git ls-files`, which names a file a move has deleted and misses one it has created — so a tree
# with an uncommitted move failed it on the file that was gone and passed it on the file that was
# new. CI pins clang-format 14; the desk has 22 and they disagree, and Windows has the one
# `fetchClangFormat` takes out of LLVM's package. **In batches**, because `xargs` with no `-n`
# hands every file to one process and `-P` then has nothing to run beside it: 8.5 s on one core,
# and 1 s in batches of 64.
checkFormat() {
    local clangFormat=clang-format-14
    if onWindows; then
        clangFormat="$(fetchClangFormat)"
    fi

    (cd "$root" && git ls-files --cached --others --exclude-standard -- ':(exclude)extern/' '*.cpp' '*.hpp' '*.h' \
        | while read -r file; do [ -f "$file" ] && printf '%s\n' "$file"; done \
        | xargs -n 64 -P "$(nproc)" "$clangFormat" --dry-run -Werror)
}

# **The fork's own targets, compiled the way a number is taken.** `-DNDEBUG` compiles every assert
# out, and a diagnostic that fires only once the assert is gone — a lookup the optimizer can now
# prove reaches a null — is one the debug build never sees. Every target the fork owns,
# `openmw-rtx-all`, since the flags that make a warning an error reach each of them; the fork's
# files inside upstream's targets are compiled by `build` in this flavour, which is the build a
# number is quoted from. A minute with the cache warm, in a subshell so the gate's own flavour
# stays what it was.
compileWithoutAsserts() {
    (
        describeFlavour release
        configureIfNeeded
        buildTargets openmw-rtx-all
    )
}

# **The backend without the SDK, compiled the way a machine without one compiles it.** The backend
# alone, because that is the one library the `#ifdef` divides; the harness and the game link it
# either way. About a minute warm, in a subshell for the reason above.
compileWithoutDlss() {
    (
        describeFlavour nodlss
        configureIfNeeded
        buildTargets openmw-rtx-vulkan
    )
}

# **One process for each binary.** The GPU binary refuses to start where there is no device, so a
# box without a driver names `--without-device` and gets the other two; a run that says nothing
# about its device is one that has one. **The GPU tests are not sharded**: the device does their
# work one frame at a time, so a shard only adds a device and a renderer of its own to wait
# beside the others — one process took 18 s, and three shards of it 21 s.
runTests() {
    local withDevice=1 args=()
    for arg in "$@"; do
        case "$arg" in
            --without-device) withDevice=0 ;;
            *) args+=("$arg") ;;
        esac
    done

    (cd "$build" && ./components-tests --gtest_filter='Rtx*:Sky*:Crash*' "${args[@]}") || return 1

    # Every way a game ends, each in a process of its own with the real catcher, and what it left
    # checked: `apps/components_tests/crashcatcher/crashtests.cpp`. Its reports go in a folder of
    # their own, which goes after.
    local reports
    reports="$(mktemp -d)"
    if ! (cd "$build" && ./crash-tests --matrix "$reports"); then
        rm -rf "${reports:?}"
        return 1
    fi
    rm -rf "${reports:?}"

    if [ "$withDevice" -eq 1 ]; then
        (cd "$build" && ./rtx-gpu-tests "${args[@]}") || return 1
    else
        echo "rtx-gpu-tests: left out, as --without-device asked"
    fi

    (cd "$build" && ./openmw-tests --gtest_filter='Rtx*' "${args[@]}")
}

# **Two processes and not two stops of one.** A second stop starts from the world the first one
# left, so the two cannot be compared frame for frame. What this asks is whether a run of the binary
# is a function of the binary, and only a second run of it answers that. A walk and not a still,
# because a still passed through both of the defects this catches: a camera that stands still was
# exactly reproducible while `osg::FrameStamp`'s reference time aged OpenMW's caches by the wall,
# and again while MyGUI aged the hit overlay by one.
#
# **The upscaler and the denoiser are off**, so what is walked is what a reconstruction is fed,
# which is where every defect this has caught showed itself — a picture that moved here is one the
# trace drew differently, with nothing temporal between. The exposure stays measured; add
# `--exposure=1` to read a difference in the picture, since a measured exposure couples every pixel
# to every other and every frame to the one before.
#
# **Every column is the gate.** The second run is compared by `bench --against`, which names the
# frames whose picture moved and the parts of the scene that did, and fails on either. One pair
# gates and ten read. Both legs' hashes are kept beside the logs of a pair that differed, so which
# frames moved can be read off the two files.
#
# **The second leg runs with the queue held behind the host.** Two runs of one binary keep the
# same phase between the host and the device, so a frame that read the device's clock — a report
# that had or had not landed, a structure compacted a frame earlier — could repeat exactly and
# still be a function of the wall; `Rtx::Timeline` says why no frame reads it now. Held, the
# device trails by half a frame, which is the other phase a run can have: a picture that is a
# function of the frames alone does not move between the two.
runRepeat() {
    local pairs=1 place=() length=() extra=()
    for arg in "$@"; do
        case "$arg" in
            --pairs=*) pairs="${arg#*=}" ;;
            --views=*|--suite=*) place+=("$arg") ;;
            --seconds=*|--frames=*) length+=("$arg") ;;
            *) extra+=("$arg") ;;
        esac
    done
    [ ${#place[@]} -eq 0 ] && place=(--views=one-cell-walk)
    [ ${#length[@]} -eq 0 ] && length=(--seconds=6)

    local out
    out="$(mktemp -d)"
    local bench=(./openmw-rtxtool bench "${place[@]}" "${length[@]}" --window=false --upscale=off --filter=false
        --validation=off "${extra[@]}")

    local pair status=0
    for pair in $(seq 1 "$pairs"); do
        (cd "$build" && "${bench[@]}" --hashes="$out/$pair.csv" > "$out/$pair-1.log" 2>&1) || {
            echo "the run itself failed, see $out/$pair-1.log:" >&2
            tail -20 "$out/$pair-1.log" >&2
            return 1
        }
        if (cd "$build" && "${bench[@]}" --hold=8 --hashes="$out/$pair-2.csv" --against="$out/$pair.csv" > "$out/$pair-2.log" 2>&1); then
            echo "pair $pair of $pairs: identical"
        elif grep -q '^against ' "$out/$pair-2.log"; then
            status=1
            echo "pair $pair of $pairs: NOT repeatable" >&2
            sed -n '/^against /,$p' "$out/$pair-2.log" >&2
        else
            echo "the run itself failed, see $out/$pair-2.log:" >&2
            tail -20 "$out/$pair-2.log" >&2
            return 1
        fi
    done

    if [ "$status" -eq 0 ]; then
        echo "repeat: $pairs pair(s), identical over every one"
        rm -rf "$out"
    else
        echo "the runs are in $out" >&2
    fi
    return "$status"
}

# **What each kernel is once its constants are fixed, as one digest per tuple: `rtx <flavour>
# kernels [--against=<file>]`.** The exact answer to "does this change move a vanilla frame",
# asked of the shaders and not of a run: two runs are the driver's code, and its code of a module
# is not a function of the module alone (`Rtx::DriverCache`). A module is specialized to each
# tuple of its boolean constants — a `uint` stays at its default — optimized so the branches
# its constants decide are gone, stripped of its source and of constants nothing reads, and
# digested by `openmw-rtx-spirv-digest`, which names every id by what it is and not by its number
# (`Rtx::digestProgram` says how, and why `spirv-opt --canonicalize-ids` could not): code no tuple
# runs, a comment, the ids and the order declarations came in all leave the digest where it was.
# Equal digests are one program for that tuple as far as its instructions can say; with
# `--against`, a file this wrote before, the tuples that moved are named and the exit status says
# whether any did.
#
# **The spec-constant operations are folded before `-O`, which holds no pass that folds them.**
# Freezing makes the constants themselves constant and leaves `!HAS_MAPS` or `WATER && HAS_SEA`
# an operation, which no branch pass reads through: unfolded, every tuple with the maps off digests
# the specular half, and every tuple with no water the water. **What still stays is float arithmetic
# on constants that the build marked `NoContraction`**, which the optimizer will not fold even
# where the result is exact; a block behind such a sum can only make a tuple move that did not,
# and taking the decoration off to fold it would let the optimizer reassociate what it must not.
kernelDigest() {
    local module constants label
    IFS=$'\t' read -r module constants label <<< "$1"
    local specialize=()
    [ -n "$constants" ] && specialize=(--set-spec-const-default-value "$constants")
    # Into a file and its messages dropped, and a refusal a failure of the listing: never a digest
    # of nothing.
    local specialized digest
    specialized="$(mktemp)"
    if ! "$optimizer" --target-env=vulkan1.4 --scalar-block-layout "${specialize[@]}" --freeze-spec-const \
        --fold-spec-const-op-composite -O --eliminate-dead-const --strip-debug --strip-nonsemantic \
        "$module" -o "$specialized" > /dev/null 2>&1; then
        echo "rtx: spirv-opt refused $(basename "$module") at ${label:--}" >&2
        rm -f "$specialized"
        return 1
    fi
    # In two steps, because the shell this runs in has no `pipefail` and a disassembly that failed
    # would otherwise be digested as whatever it wrote before it did.
    local disassembly
    disassembly="$(mktemp)"
    if ! "$disassembler" --raw-id --no-header "$specialized" -o "$disassembly" \
        || ! digest="$("$programDigest" < "$disassembly")"; then
        echo "rtx: $(basename "$module") at ${label:--} could not be digested" >&2
        rm -f "$specialized" "$disassembly"
        return 1
    fi
    rm -f "$specialized" "$disassembly"
    # The tool writes a text line, which ends in a carriage return on Windows.
    printf '%s %s %s\n' "$(basename "$module" .spv)" "${label:--}" "${digest%$'\r'}"
}

runKernels() {
    local against=""
    for arg in "$@"; do
        case "$arg" in
            --against=*) against="${arg#*=}" ;;
            *)
                echo "rtx: kernels reads --against=<file> and nothing else" >&2
                exit 2
                ;;
        esac
    done

    # The optimizer the build strips its modules with, so the two cannot be different releases.
    optimizer="$(cacheValue OPENMW_SPIRV_OPT)"
    if [ ! -x "$optimizer" ]; then
        echo "rtx: the $flavour build names no spirv-opt yet — \`rtx $flavour build\` first" >&2
        exit 2
    fi
    disassembler="$(dirname "$optimizer")/spirv-dis"
    programDigest="$build/components/rtxvulkan/openmw-rtx-spirv-digest"
    export optimizer disassembler programDigest
    export -f kernelDigest

    # Every tuple of every module: the constants off the module the driver is handed, their names
    # off the same module with its source, which keeps the ids it has.
    local shaders="$build/resources/rtx/shaders" jobs module
    jobs="$(mktemp)"
    for module in "$shaders"/*.spv; do
        local listing ids=() names=() count id name
        listing="$("$disassembler" --raw-id --no-header "$build/resources/rtx/shaders-source/$(basename "$module")" 2> /dev/null \
            || "$disassembler" --raw-id --no-header "$module")"
        while read -r id count; do
            if grep -Eq "^ *$id = OpSpecConstant(True|False) " <<< "$listing"; then
                name="$(sed -n "s/^ *OpName $id \"\(.*\)\"$/\1/p" <<< "$listing")"
                ids+=("$count")
                names+=("${name:-constant$count}")
            fi
        done < <(sed -n 's/^ *OpDecorate \(%[0-9]*\) SpecId \([0-9]*\)$/\1 \2/p' <<< "$listing" | sort -k2,2n)

        local tuple tuples=$((1 << ${#ids[@]}))
        for ((tuple = 0; tuple < tuples; ++tuple)); do
            local constants="" label="" at
            for ((at = 0; at < ${#ids[@]}; ++at)); do
                local on=$(((tuple >> at) & 1))
                constants+="${constants:+ }${ids[at]}:$([ $on = 1 ] && echo true || echo false)"
                label+="${label:+,}${names[at]}=$on"
            done
            printf '%s\t%s\t%s\n' "$module" "$constants" "$label" >> "$jobs"
        done
    done

    local listed
    listed="$(mktemp)"
    xargs -d '\n' -P "$(nproc)" -n 1 bash -c 'kernelDigest "$1"' _ < "$jobs" | LC_ALL=C sort > "$listed"
    rm -f "$jobs"

    if [ -z "$against" ]; then
        cat "$listed"
        rm -f "$listed"
        return 0
    fi

    # Keyed on the module and the tuple; a digest that differs, a tuple one side lacks.
    local moved
    moved="$(LC_ALL=C join -a 1 -a 2 -e '(none)' -o 0,1.2,2.2 \
        <(awk '{ print $1 "/" $2, $3 }' "$against" | LC_ALL=C sort) \
        <(awk '{ print $1 "/" $2, $3 }' "$listed" | LC_ALL=C sort) | awk '$2 != $3')"
    local total
    total="$(wc -l < "$listed")"
    rm -f "$listed"
    if [ -z "$moved" ]; then
        echo "kernels: all $total the same as $against"
        return 0
    fi
    echo "kernels: $(wc -l <<< "$moved") of $total moved against $against (tuple, before, now):"
    echo "$moved"
    return 1
}

# The tools an AppImage is made with, pinned by release and checksum in `pins.sh` the way the
# Windows set is, and fetched into deps/ only where the directory lacks one.
fetchAppImageTools() {
    local tools="$root/deps/appimage"
    mkdir -p "$tools"
    local file url sum
    while read -r file url sum; do
        if [ -f "$tools/$file" ]; then
            continue
        fi
        fetchChecked "$url" "$sum" "$tools/$file"
        chmod +x "$tools/$file"
    done <<< "$appImageTools"
}

# The names between `set(USED_OSG_PLUGINS` and its `)`, `osgdb_` and all, read off the one place
# that declares them so this list cannot drift from the engine's own check.
usedOsgPlugins() {
    awk '/^set\(USED_OSG_PLUGINS/{on=1; next} on{last=/\)/; sub(/\).*/, ""); if ($1 != "") print $1; if (last) exit}' \
        "$root/CMakeLists.txt"
}

# **The AppImage, the way the format's own guide says to make one.** The portable layout goes
# under `usr/bin`, since the binaries find their openmw.cfg beside themselves and the launcher
# starts the game from its own directory; the desktop file, the icon and the metainfo move up to
# `usr/share`, where the tools and a desktop integrator look for them.
#
# **OSG's plugins are the one thing no linker names.** The engine loads the nine `USED_OSG_PLUGINS`
# of the top-level CMakeLists by name at start and refuses to run without them, through OSG's own
# search: `osgPlugins-<version>/osgdb_<name>.so` under each entry of `OSG_LIBRARY_PATH`. Left to
# the host, a bundled OSG found Arch's copies and pulled Arch's `libosgSim` into a process running
# Ubuntu's `libosgUtil`. So the nine are copied under `usr/lib`, `--deploy-deps-only` brings what
# they link and sets their rpath, and an AppRun hook points OSG at them — the tool's AppRun sources
# every script under `apprun-hooks/` with `this_dir` set to the mounted image.
#
# The runtime at the front of the file is the static one, pinned by release and checksum: it runs
# on FUSE 2, FUSE 3 or none, where the old runtime dies on every distribution that dropped
# libfuse2, and without it appimagetool fetches whatever the runtime's continuous release holds
# that day. The Qt plugin bundles the Wayland platform beside X11 and, through its
# `waylandcompositor` module, the shell, buffer and decoration plugin sets a Wayland window needs —
# without the shell one it never maps — so the launcher opens on a session with no XWayland. The
# Vulkan loader goes in, the SDK's 1.4 one the binaries were linked against: the loader is not the
# driver, any driver's ICD is found through the host's manifests whichever loader asks, and the
# backend calls 1.4 entry points the loader exports — Ubuntu 24.04's 1.3 loader has none, and a
# bare one refused the binary with `undefined symbol: vkCmdPushDescriptorSet`. The update
# information points AppImageUpdate at this repository's releases and writes the `.zsync` beside
# the file. AppStream validation is off: upstream's metainfo carries warnings appstreamcli
# refuses, and its identity, the launcher's desktop id, is right. The tools are AppImages
# themselves and a runner has no FUSE, so they extract and run. What the image takes
# from the host is the AppImage exclude list — glibc and libstdc++, the GL stack, X11, Wayland,
# fontconfig, ALSA — and the binaries read glibc 2.38 and GCC 13's libstdc++ off it, which is
# late 2023's: what a bare Ubuntu 24.04 with the runtime libraries of a desktop ran them on.
#
# **The DLSS library is out of the AppDir while linuxdeploy runs.** Its last pass patches an rpath
# into every ELF file it finds there, named or not, and NVIDIA's feature library is signed: with
# four kilobytes of rpath added, NGX said the device offered no Ray Reconstruction. So the deploy
# pass runs without it, the file goes back beside the binaries untouched, and the image is then
# written by the AppImage plugin called on its own, which patches nothing.
archiveLinux() {
    local name="$1" dist="$root/dist" appdir="$root/AppDir" tools="$root/deps/appimage"
    require qmake6 "the Qt plugin reads Qt's layout off it: qt6-base-dev-tools"
    require pkg-config "OSG's version and library directory come off its .pc: pkg-config"
    require zsyncmake "the update information wants a .zsync beside the image: zsync"
    fetchAppImageTools

    rm -rf "$appdir"
    cmake --install "$build" --prefix "$appdir/usr/bin" > /dev/null
    mv "$appdir/usr/bin/share" "$appdir/usr/share"

    local osgVersion plugins plugin
    osgVersion="$(pkg-config --modversion openscenegraph-osg)"
    plugins="$(pkg-config --variable=libdir openscenegraph-osg)/osgPlugins-$osgVersion"
    mkdir -p "$appdir/usr/lib/osgPlugins-$osgVersion" "$appdir/apprun-hooks"
    for plugin in $(usedOsgPlugins); do
        cp "$plugins/$plugin.so" "$appdir/usr/lib/osgPlugins-$osgVersion/"
    done
    printf 'export OSG_LIBRARY_PATH="$this_dir/usr/lib"\n' > "$appdir/apprun-hooks/osg-plugins.sh"

    local kept="$appdir.kept"
    rm -rf "$kept"
    mkdir -p "$kept"
    mv "$appdir"/usr/bin/libnvidia-ngx-*.so.* "$kept/" 2> /dev/null || true

    local executables=() file
    for file in "$appdir"/usr/bin/*; do
        if [ -f "$file" ] && [ -x "$file" ]; then
            executables+=(--executable "$file")
        fi
    done

    APPIMAGE_EXTRACT_AND_RUN=1 QMAKE="$(command -v qmake6)" PATH="$tools:$PATH" \
        EXTRA_PLATFORM_PLUGINS='libqwayland-generic.so;libqwayland-egl.so' EXTRA_QT_MODULES=waylandcompositor \
        "$tools/linuxdeploy" --appdir "$appdir" "${executables[@]}" \
            --deploy-deps-only "$appdir/usr/lib/osgPlugins-$osgVersion" \
            --desktop-file "$appdir/usr/share/applications/org.openmw.launcher.desktop" \
            --icon-file "$appdir/usr/share/pixmaps/openmw.png" \
            --plugin qt

    mv "$kept"/* "$appdir/usr/bin/" 2> /dev/null || true
    rmdir "$kept"

    # From dist/, because appimagetool writes the .zsync into the working directory and the
    # image where it is told.
    mkdir -p "$dist"
    (cd "$dist" && APPIMAGE_EXTRACT_AND_RUN=1 \
        LDAI_RUNTIME_FILE="$tools/runtime-x86_64" LDAI_NO_APPSTREAM=1 \
        LDAI_UPDATE_INFORMATION='gh-releases-zsync|xorza|openmw-rtx|latest|openmw-rtx-v*-linux-x86_64.AppImage.zsync' \
        LDAI_OUTPUT="$dist/openmw-$name-linux-x86_64.AppImage" \
        "$tools/linuxdeploy-plugin-appimage" --appdir "$appdir")
    rm -rf "$appdir"
}

# **The portable folder, off the same install rules upstream's installer is made of** — a folder
# rather than that installer, because a fork under a renderer nobody has installed before should
# unpack beside a stock OpenMW, not register itself where one would. The zip around it is made
# where it is handed out: GitHub's own around a run's artifact, the release job's around a
# release's, so nobody downloads a zip inside a zip.
archiveWindows() {
    local name="$1" dist="$root/dist" folder
    folder="$dist/openmw-$name-windows-x64"
    rm -rf "$folder"
    cmake --install "$build" --prefix "$folder" > /dev/null
}

# **Breakpad's two tools, fetched once into `deps/crash`**, and the path of the one asked for: the
# player never has them, and the desk and CI take the versions `pins.sh` names.
crashTool() {
    local wanted="$1" tools="$root/deps/crash" system=linux suffix=""
    if onWindows; then
        system=windows
        suffix=".exe"
    fi
    local tool="$tools/$wanted$suffix"
    if [ ! -x "$tool" ]; then
        mkdir -p "$tools"
        local name os url sum archive
        while read -r name os url sum; do
            if [ "$name" != "$wanted" ] || [ "$os" != "$system" ]; then
                continue
            fi
            archive="$tools/$(basename "$url")"
            fetchChecked "$url" "$sum" "$archive"
            if onWindows; then
                "$(sevenZip)" e -y -o"$tools" "$archive" "$wanted.exe" > /dev/null
            else
                tar -xJf "$archive" -C "$tools" --strip-components=1 --wildcards "*/$wanted"
            fi
            rm "$archive"
        done <<< "$crashTools"
    fi
    echo "$tool"
}

# **The release's symbols**: every executable the package build made, through `dump_syms` into a
# Breakpad symbol store, `<module>/<id>/<module>.sym`, zipped as
# `dist/openmw-<name>-<system>-symbols.zip`. A release publishes it beside its archive, and
# `rtx package crash` reads a player's dump against it: the offsets a crash summary names become
# functions and lines. The debug information comes from the package presets, and it stays out of
# the archive.
symbols() {
    local name="$1" dist="$root/dist" system=linux store dumpSyms file
    if onWindows; then
        system=windows
    fi
    dumpSyms="$(crashTool dump_syms)"
    store="$(mktemp -d)"
    if onWindows; then
        for file in "$build"/*.exe; do
            "$dumpSyms" --store "$(nativePath "$store")" "$(nativePath "$file")" > /dev/null
        done
    else
        while read -r file; do
            "$dumpSyms" --store "$store" "$file" > /dev/null
        done < <(find "$build" -maxdepth 1 -type f -perm -u+x ! -name '*.so*')
    fi
    mkdir -p "$dist"
    (cd "$store" && cmake -E tar cf "$dist/openmw-$name-$system-symbols.zip" --format=zip .)
    rm -rf "${store:?}"
}

# **A player's dump, read against a release's symbols**: every thread, with the function and the
# line of each frame. The symbols are a release's `-symbols.zip` or a folder of one, or else the
# newest that `rtx package archive` left in dist/.
readCrash() {
    local dump="${1:-}" symbols="${2:-}" folder walker
    if [ -z "$dump" ] || [ ! -f "$dump" ]; then
        echo "rtx: name the dump to read: \`rtx package crash <dump> [symbols]\`" >&2
        exit 2
    fi
    if [ -z "$symbols" ]; then
        symbols="$(ls -t "$root"/dist/*-symbols.zip 2> /dev/null | head -n 1 || true)"
    fi
    if [ -z "$symbols" ]; then
        echo "rtx: no symbols: name a release's -symbols.zip, or \`rtx package archive\` first" >&2
        exit 2
    fi
    folder="$symbols"
    if [ -f "$symbols" ]; then
        folder="$(mktemp -d)"
        (cd "$folder" && cmake -E tar xf "$symbols")
    fi
    walker="$(crashTool minidump-stackwalk)"
    "$walker" --human "$(nativePath "$dump")" "$(nativePath "$folder")"
    if [ "$folder" != "$symbols" ]; then
        rm -rf "${folder:?}"
    fi
}

# The archive out of the package build, named after the argument or the ref: a tag names its
# archives and a branch names its own. Refused before anything is built for it. The release's
# symbols come with it.
archive() {
    if [ "$flavour" != package ]; then
        echo "rtx: an archive is made of the package flavour — \`rtx package archive\`" >&2
        exit 2
    fi
    buildTargets "${targets[@]}"
    local name="${1:-$(git -C "$root" describe --tags --always)}"
    if onWindows; then
        archiveWindows "$name"
    else
        archiveLinux "$name"
    fi
    symbols "$name"
    ls -l "$root/dist"
}

# **Every run is from the build directory**, because `--resources` defaults to `./resources`, and
# the tests that read game data resolve it the way the tool does.
case "$what" in
    build)
        # The flavour's own targets, or the ones the line names: CI compiles the backend alone in
        # the `nodlss` flavour, the way the gate does.
        if [ $# -eq 0 ]; then
            addTestTargets
            set -- "${targets[@]}"
        fi
        buildTargets "$@"
        ;;
    test)
        if ! buildsTests; then
            echo "rtx: the $flavour build has no tests: \`rtx debug test\` runs them" >&2
            exit 1
        fi
        buildTargets "${testTargets[@]}"
        runTests "$@"
        ;;
    setup)
        setupGame "$@"
        ;;
    game)
        # The newest quicksave of any character unless the line names a save, so the script
        # names nobody's.
        buildTargets openmw
        save=()
        case " $* " in
            *" --load-savegame"*) ;;
            *)
                quicksave="$(find "$(userDataDir)/saves" -name Quicksave.omwsave -printf '%T@ %p\n' 2> /dev/null \
                    | sort -n | tail -1 | cut -d' ' -f2-)"
                if [ -z "$quicksave" ]; then
                    echo "rtx: no Quicksave.omwsave under $(userDataDir)/saves; name one with --load-savegame" >&2
                    exit 2
                fi
                save=(--load-savegame "$quicksave")
                ;;
        esac
        cd "$build"
        exec ./openmw --skip-menu "${save[@]}" "$@"
        ;;
    repeat)
        buildTargets openmw-rtxtool
        runRepeat "$@"
        ;;
    kernels)
        # The build's lines on the side, because the listing is what a caller keeps.
        buildTargets openmw-rtx-vulkan-shaders openmw-rtx-spirv-digest >&2
        runKernels "$@"
        ;;
    archive)
        archive "$@"
        ;;
    crash)
        readCrash "$@"
        ;;
    gate)
        # **Never a gate beside a build, or beside another gate**: the reading is then about the
        # machine. In order of cost, so a formatting slip is found in seconds and not after the
        # walk. `check` writes its pictures where it always does, under `check/`.
        checkFormat
        addTestTargets
        buildTargets "${targets[@]}"
        compileWithoutAsserts
        compileWithoutDlss
        if buildsTests; then
            runTests
        else
            echo "tests: the $flavour build has none — \`rtx debug gate\` runs them"
        fi
        (cd "$build" && ./openmw-rtxtool check "--validation=$validation")
        runRepeat --pairs=1
        echo "gate: clean"
        ;;
    -*)
        echo "rtx: name a verb before the switches — \`rtx $flavour view $what $*\`" >&2
        exit 2
        ;;
    *)
        buildTargets openmw-rtxtool
        cd "$build"
        exec ./openmw-rtxtool "$what" "$@" $(validationFor "$@")
        ;;
esac
