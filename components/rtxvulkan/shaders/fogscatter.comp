#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_ray_tracing_position_fetch : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "camera.h"
#include "look.h"
#include "scene.h"
#include "visibility.h"

#include "lib/bindings.glsl"
#include "lib/fog.glsl"
#include "lib/froxel.glsl"
#include "lib/lights.glsl"
#include "lib/random.glsl"
#include "lib/reproject.glsl"
#include "lib/shading.glsl"
#include "lib/traversal.glsl"
#include "lib/variants.glsl"

layout(local_size_x = FOG_FROXEL_WORKGROUP_ACROSS, local_size_y = FOG_FROXEL_WORKGROUP_ACROSS,
    local_size_z = FOG_FROXEL_WORKGROUP_DEEP) in;

// Coprime shifts decorrelate the 2D blue-noise tile between depth slices.
const uvec2 FOG_SLICE_TURN = uvec2(13u, 7u);

vec3 fogVolumeWas(vec3 fromEye)
{
    const vec3 was = fromEye + frame.mCameraMotion;

    const vec2 screen = previousScreen(was);
    if (screen.x < 0.0)
        return vec3(-1.0);

    const vec2 pixel = screen * vec2(frame.mCamera.mWidth, frame.mCamera.mHeight);
    return vec3(fogVolumeUV(pixel, textureSize(fogWasCoverage, 0).xy), fogVolumeDepth(length(was)));
}

void main()
{
    const ivec3 grid = imageSize(fogCoverageTarget);
    const ivec3 froxel = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(froxel, grid)))
        return;

    const ivec2 column = froxel.xy;
    const uint slice = uint(froxel.z);
    const float jitter = randomAt(uvec2(column) + FOG_SLICE_TURN * slice, STREAM_FOG);
    const Ray ray = fogColumnRay(uvec2(column));
    const vec3 origin = frame.mOrigin + ray.mOffset;
    const Ray middle = fogColumnRayAt(uvec2(column), vec2(0.5));
    const vec3 fromMiddle = frame.mOrigin + middle.mOffset;
    const float behind = froxelNear(slice);
    const float clear = min(froxelFar(slice), imageLoad(fogColumnDepth, column).x);
    const float along = behind + jitter * (max(clear, behind) - behind);
    const vec3 position = origin + ray.mDirection * along;

    // Reproject the froxel centre, rather than blurring the history at a new jittered coordinate.
    const vec3 was = fogVolumeWas(middle.mDirection * froxelMiddle(slice));
    const bool reprojected = all(greaterThanEqual(was, vec3(0.0))) && all(lessThanEqual(was, vec3(1.0)));
    const float wasCoverage = reprojected ? texture(fogWasCoverage, was).x : 1.0;
    const vec4 wasVisibility = reprojected ? texture(fogWasVisibility, was) : vec4(0.0);
    if (!(clear > behind))
    {
        imageStore(fogCoverageTarget, froxel, vec4(wasCoverage));
        imageStore(fogVisibilityTarget, froxel, wasVisibility);
        imageStore(fogLampsTarget, froxel, vec4(0.0));
        return;
    }

    // The analytic layer stays out of the history: moving a sample across water must not
    // turn a froxel into an average of two different media.
    float coverage = fogCoverageAt(position, froxelStrideAt(along));

    // Integrate lamp energy along the fixed central ray so an unfiltered lamp does not jitter.
    uint lampState = randomSeed(froxelKey(uvec2(column), slice) + SEED_LAMPS_FOG);
    Reservoir lamps = noLamps();
    const vec3 lampScatter
        = lampsInAir(lamps, lampState, fromMiddle, middle.mDirection, behind, clear) / (clear - behind);
    aimLampFrom(lamps, position);
    const float lampsSeen
        = lamps.mWeight > 0.0 ? lampVisible(lamps, vec2(randomNext(lampState), randomNext(lampState))) : 0.0;

    // Clear air still supplies lighting to smoke, and skipping visibility on clear draws biases history.
    const FogSources sources = fogSourcesAlong(ray.mDirection);
    const float sun = sources.mSunlit ? lightThrough(position, frame.mSunPosition, frame.mFar) : 1.0;
    const float lunar = sources.mMoonlit ? lightThrough(position, sources.mMoonward, frame.mFar) : 1.0;
    const float ambient
        = ambientReaching(position, vec3(0.0), vec3(0.0), 0.0, froxelKey(uvec2(column), slice) + SEED_AMBIENT_FOG);
    vec4 visibility = vec4(sun, lampsSeen, ambient, lunar);
    if (reprojected)
    {
        coverage = mix(coverage, wasCoverage, FOG_VOLUME_HISTORY);
        visibility = mix(visibility, wasVisibility, FOG_VOLUME_HISTORY);
    }

    imageStore(fogCoverageTarget, froxel, vec4(coverage));
    imageStore(fogVisibilityTarget, froxel, visibility);
    imageStore(fogLampsTarget, froxel, vec4(lampScatter, 0.0));
}
