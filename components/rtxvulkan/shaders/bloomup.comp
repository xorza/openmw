#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

// One doubling of the bloom pyramid, mixed into the level that was already there.
//
// **Mixed and not added**, so the pyramid's total does not depend on how many levels a frame had
// room for — `BLOOM_SCATTER` says why, and what a level holds after this is the blur of everything
// coarser than it.

#include "bloom.h"
#include "lib/bloom.glsl"

layout(local_size_x = BLOOM_WORKGROUP, local_size_y = BLOOM_WORKGROUP) in;

/// The coarser level, sampled bilinearly and clamped at its edges.
layout(set = 0, binding = 0) uniform sampler2D coarser;

/// The finer level, holding its own halving of the frame until this runs.
layout(set = 0, binding = 1, BLOOM_LEVEL) uniform image2D level;

layout(push_constant, scalar) uniform Push
{
    BloomConstants frame;
};

void main()
{
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= frame.mWidth || pixel.y >= frame.mHeight)
        return;

    const ivec2 at = ivec2(pixel);
    const vec2 uv = (vec2(pixel) + 0.5) / vec2(frame.mWidth, frame.mHeight);

    const vec3 spread = bloomSpread(coarser, uv, frame.mTexel);

    imageStore(level, at, vec4(mix(imageLoad(level, at).rgb, spread, frame.mMix), 1.0));
}
