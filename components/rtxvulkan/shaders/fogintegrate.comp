#version 460

#extension GL_GOOGLE_include_directive : require

// **Declared and never used**, because set zero is one block of declarations and this pass is
// addressed through the same layout as the one before it. What that block names — an acceleration
// structure, the scene's buffer references, the bindless array — each needs its extension in scope
// to be *declared*, and nothing here reads any of them.
#extension GL_EXT_ray_query : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// The air of one column, accumulated front to back, which is what a pixel reads.
//
// **A thread to a column, and that is the shape this half wants.** Transmittance can only be
// carried in one order, so the sixty-four slices are a scan and not a fan-out — and carrying it is
// what lets a slice hold the *accumulated* answer rather than its own share, so a pixel whose
// surface stands at any depth reads one fetch and never a sum. What used to make a thread to a
// column the wrong shape was everything else that was in this loop: the field, the walk of the
// light grid and three shadow rays, all of them per froxel and none of them needing an order.
// `fogscatter.comp` has those, one thread to each.
//
// **Each slice is a sample and the air between two is the line between them**, which `FogSlice`
// says why. So a slice is stepped through in two halves, each a straight piece of that line, and
// the pass writes what each slice holds beside what it has accumulated — a pixel whose surface
// stands inside a slice steps through the same line from the slice's near edge, and lands on the
// same number at its far edge.
//
// Nothing here traces, walks or samples a field. It reads three images and a depth, and does
// multiply-adds.

#include "scene.h"

#include "lib/bindings.glsl"
#include "lib/froxel.glsl"

layout(local_size_x = FOG_COLUMN_WORKGROUP, local_size_y = FOG_COLUMN_WORKGROUP) in;

/// The tent `[1 2 1]` squared, over the nine columns around one, and where each of them stands.
const float FOG_TENT[9] = float[9](1.0, 2.0, 1.0, 2.0, 4.0, 2.0, 1.0, 2.0, 1.0);
const ivec2 FOG_TENT_AT[9] = ivec2[9](ivec2(-1, -1), ivec2(0, -1), ivec2(1, -1), ivec2(-1, 0), ivec2(0, 0),
    ivec2(1, 0), ivec2(-1, 1), ivec2(0, 1), ivec2(1, 1));

/// The `i`th column of the tent around `column`, clamped to the edge of the grid — which is the
/// neighbour the sampler would have read there.
ivec2 fogTentAt(ivec2 column, int i, ivec2 grid)
{
    return clamp(column + FOG_TENT_AT[i], ivec2(0), grid - 1);
}

/// What one froxel holds, with its neighbours across the screen averaged in and every filter
/// applied.
///
/// **What a grid this coarse cannot carry on its own, which is every draw.** A shadow's edge in the
/// air is nought on one side and one on the other with nothing in between, so a froxel eight pixels
/// wide paints a step eight pixels wide; and the coverage band is the same shape — a bank is there
/// or it is not — so a froxel on a bank's edge holds one draw of a coin averaged over ten frames,
/// and the ten frames leave a third of the coin. Painted at eight pixels that is a blotch on every
/// bank's edge, which the tent takes to a third of itself. This is the spatial half of what every
/// shipping froxel volumetric does about a draw, and the temporal half is `fogscatter.comp`'s
/// history. What the lamps deliver is an integral, carries no draw and is read plain.
///
/// **Only the neighbours that hold air at this slice**, which is what makes this nine fetches and
/// not four corner taps of the sampler. A column whose surface stands short of the slice holds
/// nothing of the air there — `fogdepth.comp` says what it holds — and averaged in it darkened the
/// seeing and thinned the air in every froxel beside a surface: the lit air over a lamp-lit floor
/// dimmed by the floor's own shadow of a froxel that was never in the air. The weights are
/// renormalised over what is left, and a froxel with nothing around it in the air keeps its own.
///
/// **Across the screen and never along the ray.** A froxel is already a hundred units deep where it
/// is four wide, so what stands in front of it is a different question.
///
/// **What the lamps deliver times what a ray found, and the two came from different images.** The
/// first is an integral over the froxel and carries no draw; the second is one ray filtered over
/// ten frames and nine neighbours. Multiplying them here rather than in the pass that traced is
/// what lets each be treated as what it is.
///
/// @param surfaces where the nine columns' views of the air end, in the order of `FOG_TENT_AT`.
FogSlice sliceAt(ivec2 column, uint slice, ivec2 grid, float surfaces[9])
{
    const float near = froxelNear(slice);

    vec4 point = vec4(0.0);
    vec4 seeing = vec4(0.0);
    float total = 0.0;
    for (int i = 0; i < 9; ++i)
    {
        if (!(surfaces[i] > near))
            continue;

        const ivec2 at = fogTentAt(column, i, grid);
        point += FOG_TENT[i] * texelFetch(fogScatter, ivec3(at, int(slice)), 0);
        seeing += FOG_TENT[i] * texelFetch(fogSunward, ivec3(at, int(slice)), 0);
        total += FOG_TENT[i];
    }

    if (!(total > 0.0))
    {
        point = texelFetch(fogScatter, ivec3(column, int(slice)), 0);
        seeing = texelFetch(fogSunward, ivec3(column, int(slice)), 0);
        total = 1.0;
    }

    point /= total;
    seeing /= total;

    const vec3 lamps = texelFetch(fogLamps, ivec3(column, int(slice)), 0).xyz;

    return FogSlice(point.xyz + lamps * seeing.y, point.w, seeing.x);
}

void main()
{
    const ivec3 grid = imageSize(fogVolumeAirTarget);
    const ivec2 column = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(column, grid.xy)))
        return;

    // **Where this column's view of the air ends, and its neighbours'** — `fogdepth.comp` says why
    // it matters. Read once for the column: the tent asks for all nine at every slice.
    float surfaces[9];
    for (int i = 0; i < 9; ++i)
        surfaces[i] = imageLoad(fogColumnDepth, fogTentAt(column, i, grid.xy)).x;
    const float surface = surfaces[4];

    float transmittance = 1.0;
    vec3 scattered = vec3(0.0);
    float sunward = 0.0;
    float behind = 0.0;

    // The slice before the first is the first, and the one after the last is the last — the clamp
    // the sampler applies when a pixel reads the same line at its edges.
    FogSlice before = sliceAt(column, 0u, grid.xy, surfaces);
    FogSlice here = before;

    for (uint slice = 0u; slice < FOG_VOLUME_SLICES; ++slice)
    {
        const ivec3 froxel = ivec3(column, int(slice));
        const FogSlice next = slice + 1u < FOG_VOLUME_SLICES ? sliceAt(column, slice + 1u, grid.xy, surfaces) : here;

        // **The line must not bend toward a slice that starts past the surface**, which holds no
        // air of this column's: the far half of the slice the surface stands in is flat, the way
        // the sampler is flat past the last texel of an axis.
        //
        // **And only that half.** The slices past the surface are integrated as they stand, out of
        // whatever they held when this column's ray missed the surface — `fogscatter.comp` keeps
        // that — because a pixel at the surface's edge that sees past it reads them. Carrying the
        // last slice in the air over all of them instead drew that slice around every silhouette:
        // the lit air beside a lantern, laid over the whole of the fog behind the wall it hangs on,
        // in blocks eight pixels wide.
        const FogSlice after = froxelNear(slice + 1u) < surface ? next : here;

        // **Two straight pieces, cut at the sample.** A quarter of the way through a slice the line
        // from the previous sample stands three quarters of the way to this one, and that is the
        // mean of the near half; the far half's mean is a quarter of the way to the next.
        const float middle = froxelMiddle(slice);
        const float ahead = froxelFar(slice);

        fogThrough(transmittance, scattered, sunward, fogSliceBetween(before, here, 0.75), middle - behind);
        fogThrough(transmittance, scattered, sunward, fogSliceBetween(here, after, 0.25), ahead - middle);

        // **The accumulation at the slice's far edge**, which is the depth `fogVolumeAlong` resolves
        // a distance to, and the slice's own sample beside it, which is what that read steps
        // through from the edge before.
        imageStore(fogVolumeAirTarget, froxel, vec4(scattered, transmittance));
        imageStore(fogVolumeSunwardTarget, froxel, vec4(sunward));
        imageStore(fogSliceTarget, froxel, vec4(here.mInscatter, here.mExtinction));
        imageStore(fogSliceSunwardTarget, froxel, vec4(here.mSunward));

        behind = ahead;
        before = here;
        here = next;
    }
}
