#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_image_load_formatted : require

// The wavelet's temporal half: this pixel's bounce, averaged with what the same surface gave on the
// frames before it.
//
// **The cascade behind this exists to fill in where this was rejected.** That is the shape every
// denoiser the field settled on has — SVGF, A-SVGF, ReLAX, ReBLUR — and the renderer had the second
// half without the first: five spatial levels blurring a single sample, with no way to tell a bright
// pixel from a wrong one. An average over frames is where the estimator's error actually falls, and
// the variance it produces on the way is what finally lets the cascade stop at an edge in the
// *light* rather than only at an edge in the geometry.
//
// **The history is this pass's own and not the G-buffer's.** What it has to answer is "does the
// history at that pixel belong to this surface", which is a question about what was accumulated
// rather than about what the frame drew — so the normal and the distance the history belongs to are
// carried beside the history itself.

#include "accumulate.h"
#include "atrous.h"
#include "colour.h"
#include "gbuffer.h"
#include "sets.h"

#include "lib/pixels.glsl"

layout(local_size_x = ACCUMULATE_WORKGROUP, local_size_y = ACCUMULATE_WORKGROUP) in;

/// The bounce this frame traced, one sample a pixel, exactly as the trace left it. No format,
/// because the run decides the channel's width — `gbuffer.h` says which run gets which.
layout(set = SET_PASS, binding = ACCUMULATE_BIND_INDIRECT) uniform readonly image2D indirect;

/// Where each surface stood on the previous frame's screen, less where it stands on this one.
layout(set = SET_PASS, binding = ACCUMULATE_BIND_MOTION, GBUFFER_MOTION) uniform readonly image2D motion;

/// The shading normal in `xyz`. A ray that hit nothing left a zero normal, which no surface matches.
layout(set = SET_PASS, binding = ACCUMULATE_BIND_GUIDE, GBUFFER_GUIDE) uniform readonly image2D guide;

/// Clip depth in `r` and the distance from the eye in `g`. This reads the second, in world units.
layout(set = SET_PASS, binding = ACCUMULATE_BIND_DEPTH, GBUFFER_DEPTH) uniform readonly image2D depth;

/// Last frame's mean in `rgb`.
///
/// **Written by the cascade's first level and not by this pass**, which is SVGF's feedback: what a
/// pixel carries forward is the filtered light rather than the single sample it blended, so the
/// history it draws on is as quiet as the picture the frame showed. How many frames are in it is
/// the fourth channel of `historyMoments`.
layout(set = SET_PASS, binding = ACCUMULATE_BIND_HISTORY_COLOUR, ACCUMULATE_COLOUR)
    uniform readonly image2D historyColour;

/// The surface last frame's mean belongs to: its normal in `xyz` and its distance from the eye in
/// `w`. Zero normal where nothing was accumulated.
layout(set = SET_PASS, binding = ACCUMULATE_BIND_HISTORY_SURFACE, ACCUMULATE_SURFACE)
    uniform readonly image2D historySurface;

/// The first and second moments of that mean's luminance in `rg`, and in `a` how many frames the mean
/// holds. `b` holds nothing: the variance goes to the cascade beside the blend.
layout(set = SET_PASS, binding = ACCUMULATE_BIND_HISTORY_MOMENTS, ACCUMULATE_MOMENTS)
    uniform readonly image2D historyMoments;

layout(set = SET_PASS, binding = ACCUMULATE_BIND_SURFACE_OUT, ACCUMULATE_SURFACE) uniform writeonly image2D surfaceOut;
layout(set = SET_PASS, binding = ACCUMULATE_BIND_MOMENTS_OUT, ACCUMULATE_MOMENTS) uniform writeonly image2D momentsOut;

/// This frame's bounce blended with the history in `rgb`, which is what the cascade reads, and in `a`
/// the variance of its luminance, which the cascade weighs a tap by and carries through its levels.
///
/// **The variance is written rather than left to be derived, and the single-sample case is why.**
/// `E[l²] - E[l]²` over one sample is exactly nought, which a filter reads as "this pixel is
/// certain" — the opposite of the truth, and it would leave the noise precisely where it is. What a
/// pixel with no history has is no idea how noisy it is, and the honest value for that is the
/// largest one, not the smallest.
///
/// **The cascade's channel and not the trace's**, so `CHANNEL_INDIRECT` keeps what the trace put
/// there for the whole of the frame. `AccumulatePass::record` says what that separation is worth.
layout(set = SET_PASS, binding = ACCUMULATE_BIND_BLENDED_OUT, ATROUS_CHANNEL) uniform writeonly image2D blendedOut;

layout(push_constant, scalar) uniform Push
{
    AccumulateConstants frame;
};

/// The variance written where a pixel has no history to have measured one.
///
/// **One, which the cascade reads as "trust the neighbours entirely".** A pixel with a single sample
/// in it has no idea how noisy it is, and the honest answer to that is not nought — nought is what
/// says the pixel is certain, and a filter told that leaves the noise exactly where it is.
const float NO_HISTORY_VARIANCE = 1.0;

/// Whether the history at `at` belongs to the surface now in front of this pixel.
///
/// @param scaled how far that surface is, in the units `surfaceOut` holds rather than in world
///        ones. `AccumulateConstants::mDistanceScale` says what those are and why.
bool sameSurface(ivec2 at, vec3 normal, float scaled)
{
    if (outsideOf(at, uvec2(frame.mCamera.mWidth, frame.mCamera.mHeight)))
        return false;

    const vec4 was = imageLoad(historySurface, at);
    if (dot(was.xyz, was.xyz) <= 0.0)
        return false;

    return dot(was.xyz, normal) >= ACCUMULATE_FACING
        && abs(was.w - scaled) <= ACCUMULATE_DEPTH * max(scaled, frame.mDistanceScale);
}

void main()
{
    const ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (outsideOf(uvec2(at), uvec2(frame.mCamera.mWidth, frame.mCamera.mHeight)))
        return;

    const vec3 sampled = imageLoad(indirect, at).rgb;
    const vec3 normal = imageLoad(guide, at).xyz;
    const float scaled = imageLoad(depth, at).g * frame.mDistanceScale;

    // A pixel with no surface under it has nothing to accumulate and nothing to hand on. The sky is
    // resolved into `direct` by the trace and never reaches here as light.
    if (dot(normal, normal) <= 0.0)
    {
        // **The sky writes its sample on too, and it has to.** The cascade copies a pixel with no
        // surface straight through, so one this never wrote would arrive there as whatever the
        // allocation held — and the composite multiplies it by an albedo of nought, which turns a
        // stray infinity into a NaN rather than into nothing.
        imageStore(blendedOut, at, vec4(sampled, NO_HISTORY_VARIANCE));
        imageStore(surfaceOut, at, vec4(0.0));
        imageStore(momentsOut, at, vec4(0.0));

        return;
    }

    // **Where this surface was, in the same coordinates the vector was written against.** The trace
    // aims through `pixel + 0.5 + jitter` and `reprojected` differences against exactly that, so
    // undoing it has to add the same offset back or the history is fetched a fraction of a pixel out
    // — by a different fraction every frame, which is a still image that shakes.
    const vec2 moved = imageLoad(motion, at).xy;
    const vec2 before = vec2(at) + 0.5 + frame.mCamera.mJitter + moved;

    // **Bilinear over the four it landed between, each taken only if it is this surface.** A nearest
    // tap is a history that steps a whole pixel at a time, which under any camera motion is a crawl
    // along every edge; weighting the four and dropping the ones that are a different surface is
    // what keeps it smooth without dragging the wall behind into the floor in front.
    const vec2 corner = before - 0.5;
    const vec2 across = fract(corner);
    const ivec2 low = ivec2(floor(corner));

    vec3 mean = vec3(0.0);
    vec2 moments = vec2(0.0);
    float frames = 0.0;
    float weight = 0.0;

    if (frame.mReset == 0u)
    {
        // Which of the four, and its share, are arithmetic on the counter rather than two tables
        // read at it — `atrous.comp`'s `kernelAt` says why a fixed table is not one here.
        for (int i = 0; i < 4; ++i)
        {
            const ivec2 quadCorner = ivec2(i & 1, i >> 1);
            const vec2 share = mix(vec2(1.0) - across, across, vec2(quadCorner));
            const float bilinear = share.x * share.y;

            const ivec2 tap = low + quadCorner;
            if (bilinear <= 0.0 || !sameSurface(tap, normal, scaled))
                continue;

            const vec4 heldMoments = imageLoad(historyMoments, tap);
            mean += imageLoad(historyColour, tap).rgb * bilinear;
            moments += heldMoments.rg * bilinear;
            frames += heldMoments.a * bilinear;
            weight += bilinear;
        }
    }

    const float lit = dot(sampled, LUMINANCE_WEIGHTS);

    vec3 blended = sampled;
    vec2 blendedMoments = vec2(lit, lit * lit);
    // **Not `length`, which is GLSL's own**: a local of that name hides the builtin from everything
    // below it, and the next edit that reaches for one gets a compile error with no explanation in it.
    float count = 0.0;
    float variance = NO_HISTORY_VARIANCE;

    if (weight > 0.0)
    {
        mean /= weight;
        moments /= weight;
        frames /= weight;

        // **The outlier test, and it needs no number that is about this game.** What a firefly is
        // cannot be said in radiance — a bounce that lands on a lamp returns that lamp's intensity,
        // and a lamp's intensity is content — but it can be said in standard deviations from what
        // this pixel has been seeing. Under `ACCUMULATE_SETTLED` frames there is not enough history
        // to have measured a spread with, and the clamp holds off rather than inventing one.
        if (frames >= ACCUMULATE_SETTLED && lit > 0.0)
        {
            const float spread = sqrt(max(moments.y - moments.x * moments.x, 0.0));
            const float ceiling = moments.x + ACCUMULATE_SIGMAS * spread;
            if (lit > ceiling)
                blended = sampled * (ceiling / lit);
        }

        // One over the count, floored at the longest history a pixel may keep: an exact mean while
        // the history is short, an exponential one once it is long enough that its oldest frames
        // describe a surface the light has since moved off.
        count = min(frames + 1.0, ACCUMULATE_FRAMES);

        const float alpha = 1.0 / count;
        const float kept = dot(blended, LUMINANCE_WEIGHTS);

        blended = mix(mean, blended, alpha);
        blendedMoments = mix(moments, vec2(kept, kept * kept), alpha);

        if (frames >= ACCUMULATE_SETTLED)
            variance = max(blendedMoments.y - blendedMoments.x * blendedMoments.x, 0.0);
    }

    imageStore(blendedOut, at, vec4(blended, variance));
    imageStore(surfaceOut, at, vec4(normal, scaled));
    imageStore(momentsOut, at, vec4(blendedMoments, 0.0, count));
}
