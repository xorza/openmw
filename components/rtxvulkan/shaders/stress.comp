#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_realtime_clock : require

// A loop that holds the queue for as long as it is told and reads nothing the frame has, so that a
// frame recorded over it is a frame recorded over a device that is still busy — what
// `--stress-overlap` is for.
//
// **Held against the device's real-time clock, and not by a count.** A count is a time only at
// one clock, and the card's clock is not the same from one frame to the next: a count set from
// the frame before read 0.9 ms on one frame and 5.5 on the next off an idle card, and took a
// dozen frames to settle. `clockRealtimeEXT` runs at a fixed rate whatever the card is clocked at,
// so the loop leaves when the time it was told has passed, on the first frame as on every other.

#include "counts.h"
#include "stress.h"

layout(local_size_x = STRESS_WORKGROUP) in;

layout(set = 0, binding = 0, scalar) buffer Counted
{
    FrameCounts counts;
};

layout(push_constant, scalar) uniform Push
{
    StressConstants frame;
};

void main()
{
    const uint64 start = clockRealtimeEXT();
    const uint64 asked = uint64(frame.mNanoseconds);

    uint64 elapsed = 0ul;
    while (elapsed < asked)
        elapsed = clockRealtimeEXT() - start;

    // What the loop's own clock came to, for `FrameResult::mHeldMs`.
    if (gl_LocalInvocationIndex == 0u)
        counts.mHeldNs = uint(elapsed);
}
