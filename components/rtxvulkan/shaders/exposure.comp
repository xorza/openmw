#version 460

#extension GL_GOOGLE_include_directive : require

// The luminance histogram reduced to the one number the display curve scales by.
//
// One workgroup of exactly `EXPOSURE_BINS` threads: the whole job is a 256-element weighted sum, and
// dispatching it apart from the curve is what stops every one of the curve's workgroups redoing it.

#include "exposure.h"
#include "sets.h"

layout(local_size_x = EXPOSURE_BINS) in;

layout(set = SET_PASS, binding = EXPOSURE_BIND_HISTOGRAM, scalar) buffer Histogram
{
    uint bins[];
};

layout(set = SET_PASS, binding = EXPOSURE_BIND_EXPOSURE, scalar) buffer Exposure
{
    float exposure;
};

layout(push_constant, scalar) uniform Push
{
    ExposureConstants frame;
};

shared uint weighted[EXPOSURE_BINS];

void main()
{
    const uint index = gl_LocalInvocationIndex;

    // Weighted by the bin's own index: summed and divided by the population, this is the mean bin,
    // which is the mean *log* luminance because the bins are logarithmic.
    weighted[index] = bins[index] * index;
    barrier();

    // Tree reduction over the workgroup: 256 values to one in eight steps.
    for (uint stride = EXPOSURE_BINS / 2u; stride > 0u; stride >>= 1u)
    {
        if (index < stride)
            weighted[index] += weighted[index + stride];
        barrier();
    }

    if (index != 0u)
        return;

    // Bin zero holds the pixels too dark to bin. They are left out of the divisor as well as
    // contributing nothing to the sum — an interior is mostly them, and counting them would pull the
    // average onto the floor and open the exposure until the lit parts blew out.
    const uint black = bins[0];

    // **What this frame asks for, which is not yet what it gets.** Every branch below settles a
    // target and exactly one write happens after them, so the degenerate case is smoothed like any
    // other, rather than snapping a night exterior from an exposure of order tens to exactly one
    // between two frames.
    float target;
    if (frame.mPixels <= black)
    {
        // Nothing was bright enough to bin, so there is nothing to expose for.
        target = 1.0;
    }
    else
    {
        const float lit = float(frame.mPixels - black);
        const float meanBin = float(weighted[0]) / lit;

        const float meanLuminance = binLuminance(meanBin);

        // **The hour and the compensation are applied before the clamps and before the approach**, so
        // what the eye moves toward is already the held-back value: a bias taken off afterwards would
        // be a second adaptation chasing the first.
        target = clamp(frame.mBias * exp2(EXPOSURE_COMPENSATION)
                * pow(EXPOSURE_KEY / max(meanLuminance, 1e-6), EXPOSURE_ADAPTATION),
            EXPOSURE_MIN, EXPOSURE_MAX);
    }

    // **A frame with no past takes the target outright**, which is the first frame of a run and any
    // frame the renderer was told to reconstruct without one. The buffer holds whatever it held, and
    // on the very first frame that is uninitialised device memory.
    if (frame.mReset != 0u || !(frame.mElapsed > 0.0))
    {
        exposure = target;
        return;
    }

    // **Adaptation happens over time, and this was the only term in the frame that did not.** The
    // rate is asymmetric because the eye is: opening in the dark is slow and closing in the light is
    // quick.
    const float held = exposure;
    const float tau = target > held ? EXPOSURE_RISE_SECONDS : EXPOSURE_FALL_SECONDS;

    // `1 - exp(-dt / tau)` and not a fixed fraction per frame: the same share of the gap closes per
    // second whether the second held one frame or two hundred, so the picture does not change when
    // the frame time does.
    exposure = mix(held, target, clamp(1.0 - exp(-frame.mElapsed / tau), 0.0, 1.0));
}
