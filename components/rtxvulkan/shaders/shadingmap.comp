#version 460

#extension GL_GOOGLE_include_directive : require

// The estimate of the light painted into a texture, made where the texture is.
//
// **One workgroup per texture, one thread per cell of the grid, over the sums `shadingsum.comp`
// left.** `Rtx::ShadingMap` says what the estimate is: the mean linear luminance of each of the
// grid's cells over the finest level, the empty cells filled with the mean of the rest, blurred
// three by three around the wrap, and normalised to average one between the floor and the
// ceiling. This is that, in the same arithmetic, on the device: the texture is uploaded anyway,
// the map lives on the device and nothing reads it back, so an estimate made on the host walked
// every texel of every texture on the frame a live model first stood — a spawned actor's ten
// textures were the worst frame the placement row held — and the cell ring had to read it ahead
// for cells, which it no longer does. The host's class stays as the reference a device test holds
// this against.
//
// **Every reduction is a fixed tree** and nothing adds to a shared word out of order, so a
// texture's map is the same map on every run, which the repeat gate holds the picture to.
//
// **A texel goes to the cell its own centre lands in.** The host sums a block format by the
// block and puts the whole block in the cell its centre lands in, which is the same cell for
// every texture at least 128 across — a cell is then four texels or more, a block's width —
// and differs by a block's edge for the few smaller ones, where this is the exact quantity.

#include "shadingmap.h"

layout(local_size_x = SHADING_EXTENT, local_size_y = SHADING_EXTENT) in;

/// Every cell's sum, as the summing stage left it.
layout(set = 0, binding = SHADING_MAP_BIND_SUMS, scalar) readonly buffer Sums
{
    ShadingSum sums[];
};

/// The map, as the trace samples it: `Rtx::encodeShading`'s unorm, one cell a texel.
layout(set = 0, binding = SHADING_MAP_BIND_MAP, r16) uniform writeonly image2D map;

const uint CELLS = SHADING_EXTENT * SHADING_EXTENT;

shared float values[CELLS];
shared float across[CELLS];

/// The two sums a tree reduces, side by side so one tree carries both.
shared float partSum[CELLS];
shared uint partCount[CELLS];

/// Sums `partSum` and `partCount` into entry nought, in an order that is the same every time.
void reduce(uint id)
{
    for (uint stride = CELLS / 2u; stride > 0u; stride >>= 1u)
    {
        barrier();
        if (id < stride)
        {
            partSum[id] += partSum[id + stride];
            partCount[id] += partCount[id + stride];
        }
    }
    barrier();
}

void main()
{
    const uint column = gl_LocalInvocationID.x;
    const uint row = gl_LocalInvocationID.y;
    const uint id = row * SHADING_EXTENT + column;

    // This cell's texels, summed: empty for a cell a texture too small to reach every cell
    // reached nothing of.
    const float sum = sums[id].mSum;
    const uint count = sums[id].mCount;

    // A texture smaller than the grid resolves into a handful of cells and leaves the rest
    // empty. Reading those as black would make the estimate a spike and drive the correction
    // into its clamps, so too few texels to resolve shading means the same as having none.
    partSum[id] = count > 0u ? sum / float(count) : 0.0;
    partCount[id] = count > 0u ? 1u : 0u;
    reduce(id);
    const float total = partSum[0];
    const uint sampled = partCount[0];

    // A texture that counted nothing is content, not a broken contract: a BC1 cutout whose
    // every texel is a hole resolves no cell, and keeps the neutral map.
    float value = 1.0;
    if (sampled > 0u)
    {
        const float average = total / float(sampled);
        values[id] = count > 0u ? sum / float(count) : average;

        const uint left = (column + SHADING_EXTENT - 1u) % SHADING_EXTENT;
        const uint right = (column + 1u) % SHADING_EXTENT;
        const uint above = (row + SHADING_EXTENT - 1u) % SHADING_EXTENT;
        const uint below = (row + 1u) % SHADING_EXTENT;

        for (uint pass = 0u; pass < SHADING_BLUR_PASSES; ++pass)
        {
            barrier();
            across[id] = (values[row * SHADING_EXTENT + left] + values[id] + values[row * SHADING_EXTENT + right]) / 3.0;
            barrier();
            values[id]
                = (across[above * SHADING_EXTENT + column] + across[id] + across[below * SHADING_EXTENT + column]) / 3.0;
        }
        barrier();

        // Normalising is what makes this a redistribution rather than a dimmer. Dividing by a
        // map that averages one moves light from where the texture already had it to where it
        // did not, and leaves the total alone.
        partSum[id] = values[id];
        partCount[id] = 0u;
        reduce(id);
        const float mean = partSum[0] / float(CELLS);

        // A texture that is black everywhere has no lighting to redistribute and no scale to
        // divide by, so it keeps the neutral map it would otherwise be given nonsense in place of.
        if (mean > 0.0)
            value = clamp(values[id] / mean, SHADING_FLOOR, SHADING_CEILING);
    }

    imageStore(map, ivec2(column, row), vec4(shadingUnit(value)));
}
