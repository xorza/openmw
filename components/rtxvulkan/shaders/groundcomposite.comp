#version 460

#extension GL_GOOGLE_include_directive : require

// A chunk's whole layer stack, flattened into one texture — the shading LOD — made on the
// device, in the placement that wrote the chunk's material row.
//
// **The same sum the hit shader runs, once a texel instead of once a hit.** `ground.glsl` is the
// sum, written once for both, so a flattened chunk cannot disagree with the stack it replaces:
// each layer's weight off its mask, its texel off its own tiling at the level a texel of the
// composite resolves, the light painted into it divided out in full, and the stack summed in
// light. Stored display-encoded through a `UNORM` view of the composite's `SRGB` image, which
// is what the trace then samples as any file. The chain below the first level is blitted, box
// filtered in light through the same `SRGB` format, which is the filter the sum was made for.
//
// **On the device and in the placement rather than on threads of the host**, where this was
// tens of milliseconds a chunk and dozens of chunks a ring fill: the layers are textures the
// device already holds, the masks and the layer rows are tables it already reads, and a texture
// nothing reads back has no business crossing to the host at all.

#include "colour.h"
#include "ground.h"

#include "lib/ground.glsl"

layout(local_size_x = GROUND_COMPOSITE_WORKGROUP, local_size_y = GROUND_COMPOSITE_WORKGROUP) in;

/// The composite's finest level, through the view that stores what it is handed unchanged: the
/// bytes written are the display-encoded ones the sampler decodes through the other view.
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D composite;

layout(push_constant, scalar) uniform Push
{
    GroundCompositeConstants chunk;
};

void main()
{
    const uvec2 texel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(texel, uvec2(GROUND_COMPOSITE_EXTENT))))
        return;

    // The centre of this texel over the chunk, which is the composite's own coordinates: a
    // composite has no tiling, and is read edge to edge.
    const vec2 chunkUv = (vec2(texel) + 0.5) / float(GROUND_COMPOSITE_EXTENT);

    const GpuMaterial material = MaterialTable(chunk.mMaterials).at[chunk.mMaterial];
    LayerTable layers = LayerTable(chunk.mLayers);
    MaskTable masks = MaskTable(chunk.mMasks);

    // The stack in its own order, because a float sum is the order it was added in — and so
    // the order the hit shader adds it in.
    vec3 albedo = vec3(0.0);
    for (uint i = 0u; i < material.mLayerCount; ++i)
    {
        const GpuLayer layer = layers.at[material.mLayerOffset + i];
        const float showing = maskWeightIn(layer, chunkUv, masks);
        if (showing <= 0.0)
            continue;

        albedo += showing
            * sampleAlbedoLod(layer.mDiffuse, layerUv(layer, chunkUv),
                groundLod(layer.mDiffuse, layer, GROUND_COMPOSITE_EXTENT), GROUND_COMPOSITE_DELIGHT);
    }

    // Opaque, because ground is not see-through: a composite left with its alpha at nought is a
    // chunk the cutout test throws every ray straight through.
    imageStore(composite, ivec2(texel), vec4(encodeSrgb(albedo), 1.0));
}
