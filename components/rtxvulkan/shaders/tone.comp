#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

// Scene-referred radiance to bytes a display understands, and the sky's own points over it.
//
// **The one pass that knows what a display is**, and the last thing in the frame for that reason:
// everything before it works in linear radiance, including the upscaler, which reconstructs from
// several frames of it. Being last is also what makes it the only pass that can draw a point source
// — `ToneConstants::mStars` says why one cannot survive the upscaler.
//
// Exposure is a multiply and the curve is `toneMap`'s, which is where a highlight is rolled off
// rather than clipped.

#include "camera.h"
#include "colour.h"
#include "gbuffer.h"
#include "tone.h"

#include "lib/bloom.glsl"
#include "lib/starfield.glsl"

layout(local_size_x = TONE_WORKGROUP, local_size_y = TONE_WORKGROUP) in;

/// The finished frame in linear radiance, at whatever resolution the pass before this produced.
layout(set = 0, binding = 0, rgba32f) uniform readonly image2D colour;

/// The picture, as bytes a display understands.
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D target;

/// What to scale the frame by before the curve — measured off this same image by the two passes
/// before this one, or written straight in where a caller named a fixed value.
layout(set = 0, binding = 3, scalar) readonly buffer Exposure
{
    float exposure;
};

/// What the star field has to be drawn through, at the trace's own extent. `bindings.glsl` declares
/// the other end of it.
layout(set = 0, binding = 2, GBUFFER_STARS) uniform readonly image2D starsShown;

/// The bloom pyramid's finest level, which holds the blur of every level under it.
layout(set = 0, binding = 4) uniform sampler2D bloom;

layout(push_constant, scalar) uniform Push
{
    ToneConstants frame;
};

void main()
{
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= frame.mWidth || pixel.y >= frame.mHeight)
        return;

    const ivec2 at = ivec2(pixel);
    vec4 lit = imageLoad(colour, at);

    // **What the lens does with the light that reached it**, and the last thing done in linear
    // radiance. `BloomPass` says why there is no threshold and why the pyramid is mixed rather than
    // added; `ToneConstants::mBloom` says why it lands here and not on the radiance image itself.
    if (frame.mBloom > 0.0)
    {
        const vec2 uv = (vec2(pixel) + 0.5) / vec2(frame.mWidth, frame.mHeight);
        lit.rgb = mix(lit.rgb, bloomSpread(bloom, uv, frame.mBloomTexel), frame.mBloom);
    }

    // **The sky's own points, drawn where they are shown.** `ToneConstants::mStars` says why they
    // are not the trace's. What is left of them at a pixel is not this pass's to work out — a moon,
    // a cloud deck, a window pane, the water and the air all stand between the field and the eye,
    // and every one of them is the trace's — so the trace states it and this multiplies by it.
    //
    // **After the veil and so outside it**, because the pyramid was built before this pass ran and
    // a field drawn here was never in it. A star is a point at the resolution it is shown at, which
    // is the whole reason it is drawn here at all.
    //
    // Nearest and one tap, so a star within a traced pixel of a silhouette can land on the wrong
    // side of it — which against a sheet that is 99% transparent is a star at the edge of a rock
    // once in a while, and the four taps that would rule it out are four times the traffic for it.
    if (frame.mStars.mTexture != NO_TEXTURE)
    {
        const vec2 across = vec2(frame.mTracedWidth, frame.mTracedHeight) / vec2(frame.mWidth, frame.mHeight);
        const vec3 shown = imageLoad(starsShown, ivec2(vec2(pixel) * across)).rgb;

        if (any(greaterThan(shown, vec3(0.0))))
            lit.rgb += shown
                * starField(frame.mStars, rayAt(frame.mCamera, vec2(pixel)).mDirection, pixelBlur(frame.mCamera));
    }

    // The curve maps radiance to a display; coverage is not radiance and passes through it.
    imageStore(target, at, vec4(encodeSrgb(toneMap(lit.rgb * exposure)), lit.a));
}
