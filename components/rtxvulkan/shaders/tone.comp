#version 460

#extension GL_GOOGLE_include_directive : require
// No format, because the images that reach this binding are not one format: the composite's
// frame at whichever width the run chose, or the upscaler's half floats.
#extension GL_EXT_shader_image_load_formatted : require

// Scene-referred radiance to bytes a display understands, and the sky's own points over it.
//
// **The one pass that knows what a display is**, and the last thing in the frame for that reason:
// everything before it works in linear radiance, including the upscaler, which reconstructs from
// several frames of it. Being last is also what makes it the only pass that can draw a point source
// — `ToneConstants::mStars` says why one cannot survive the upscaler.
//
// Exposure is a multiply, the grade is `graded`'s and the curve is `toneMap`'s, which is where a
// highlight is rolled off rather than clipped.

#include "camera.h"
#include "colour.h"
#include "gbuffer.h"
#include "scene.h"
#include "sets.h"
#include "tone.h"

#include "lib/bloom.glsl"
#include "lib/pixels.glsl"
#include "lib/spritelist.glsl"
#include "lib/starfield.glsl"

layout(local_size_x = TONE_WORKGROUP, local_size_y = TONE_WORKGROUP) in;

/// The finished frame in linear radiance, at whatever resolution the pass before this produced.
layout(set = SET_PASS, binding = TONE_BIND_COLOUR) uniform readonly image2D colour;

/// The picture, as bytes a display understands.
layout(set = SET_PASS, binding = TONE_BIND_TARGET, TONE_TARGET_FORMAT) uniform writeonly image2D target;

/// What the star field has to be drawn through, at the trace's own extent. `bindings.glsl` declares
/// the other end of it.
layout(set = SET_PASS, binding = TONE_BIND_STARS_SHOWN, GBUFFER_STARS) uniform readonly image2D starsShown;

/// What to scale the frame by before the curve — measured off this same image by the two passes
/// before this one, or written straight in where a caller named a fixed value.
layout(set = SET_PASS, binding = TONE_BIND_EXPOSURE, scalar) readonly buffer Exposure
{
    float exposure;
};

/// The bloom pyramid's finest level, which holds the blur of every level under it.
layout(set = SET_PASS, binding = TONE_BIND_BLOOM) uniform sampler2D bloom;

/// How much of the sun's quad the eye can see, eased — `sunglare.comp` — or nought for a picture.
layout(set = SET_PASS, binding = TONE_BIND_SUN_GLARE, scalar) readonly buffer SunGlareShare
{
    float sunGlareShare;
};

/// What the trace left of the puffs at the traced extent: the shells' transmittance in `y` is what
/// `puffsCoverNothing` reads.
layout(set = SET_PASS, binding = TONE_BIND_PUFFS_DEPTH, GBUFFER_PUFF_DEPTH) uniform readonly image2D puffsDepth;

layout(push_constant, scalar) uniform Push
{
    ToneConstants frame;
};

void main()
{
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    const uvec2 extent = uvec2(frame.mCamera.mWidth, frame.mCamera.mHeight);
    if (outsideOf(pixel, extent))
        return;

    const ivec2 at = ivec2(pixel);
    vec4 lit = imageLoad(colour, at);

    // **What the lens does with the light that reached it**, and the last thing done in linear
    // radiance. `BloomPass` says why there is no threshold and why the pyramid is mixed rather than
    // added; `ToneConstants::mBloom` says why it lands here and not on the radiance image itself.
    if (frame.mBloom > 0.0)
    {
        const vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
        lit.rgb = mix(lit.rgb, bloomSpread(bloom, uv, frame.mBloomTexel), frame.mBloom);
    }

    // **The sky's own points, drawn where they are shown.** `ToneConstants::mStars` says why they
    // are not the trace's. What is left of them at a pixel is not this pass's to work out — a moon,
    // a cloud deck, a window pane, the water and the air all stand between the field and the eye,
    // and every one of them is the trace's — so the trace states it and this multiplies by it.
    //
    // **After the veil and so outside it**, because the pyramid is built before this pass runs and
    // a field drawn here is never in it. A star is a point at the resolution it is shown at, which
    // is the whole reason it is drawn here at all.
    //
    // Nearest and one tap, so a star within a traced pixel of a silhouette can land on the wrong
    // side of it — which against a sheet that is 99% transparent is a star at the edge of a rock
    // once in a while, and the four taps that would rule it out are four times the traffic for it.
    // The traced pixel under this one's centre, which is the one the puffs' composite read too.
    TexelTable texels = TexelTable(frame.mTextureTexels);
    if (holdsTexture(texels, frame.mStars.mTexture))
    {
        const uvec2 traced = tracedPixelUnder(pixel, extent, uvec2(frame.mTracedWidth, frame.mTracedHeight));
        const vec3 shown = imageLoad(starsShown, ivec2(traced)).rgb;

        // And through the puffs, whose transmittance the composite left in the frame's alpha at
        // this pass's own resolution — `ToneConstants::mCoverAlpha` — wherever it drew one; where
        // it drew none it wrote nothing, and the alpha there is whatever the upscaler left.
        float puffs = 1.0;
        if (frame.mCoverAlpha != 0u)
        {
            const float shellsThrough = imageLoad(puffsDepth, ivec2(traced)).y;
            puffs = puffsCoverNothing(SpriteTileList(frame.mSpriteTileList), SpritePresence(frame.mSpritePresence),
                        frame.mTracedWidth, traced, shellsThrough)
                ? 1.0
                : lit.a;
        }

        if (any(greaterThan(shown, vec3(0.0))) && puffs > 0.0)
            lit.rgb += shown * puffs
                * starField(frame.mStars, texels, rayAt(frame.mCamera, vec2(pixel)).mDirection, pixelBlur(frame.mCamera));
    }

    // The curve maps radiance to a display; coverage is not radiance and passes through it, and
    // where the alpha carried the puffs instead, the picture is whole.
    // **The glare fader over the encoded picture, added and clamped.** The rasterizer draws it as a
    // full-screen quad blended `SRC_ALPHA, ONE` into the framebuffer after the world, which is a
    // sum in the display's own values that the framebuffer then saturates — so it is added here,
    // after the curve and the encode, and nowhere the light is still light.
    const vec3 encoded = encodeSrgb(toneMap(graded(lit.rgb * exposure, TONE_CONTRAST, TONE_SATURATION)));
    const vec3 washed = min(encoded + frame.mGlareColour * (frame.mGlareAmount * sunGlareShare), vec3(1.0));

    imageStore(target, at, vec4(washed, frame.mCoverAlpha != 0u ? 1.0 : lit.a));
}
