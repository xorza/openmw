#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_ray_tracing_position_fetch : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// The weather's air, integrated once for a block of pixels instead of once for each of them.
//
// **This is the march `fogAlong` used to make, moved and then filtered.** Every term is the one the
// per-pixel version carried — the same coverage field, the same closed-form self-shadowing, the same
// one shadow ray per stretch, the same reservoir over the lamps. What changed is who pays: a thread
// here stands for `FOG_VOLUME_SCALE` squared pixels, and the trace reads what it left.
//
// **A thread to a column, and the whole column in one pass.** Front-to-back is the only order in
// which transmittance can be carried, and carrying it is what lets a slice hold the *accumulated*
// answer rather than its own share — so a pixel whose surface stands at any depth reads one fetch
// and never a sum.
//
// **And every sample is jittered inside its froxel and averaged with where it stood last frame.**
// That pairing is the whole of what makes a grid this coarse invisible, and it is what every
// shipping froxel volumetric does: without it the grid draws its own eight-pixel staircase across
// every shadow edge in the air. `fogWasScatter` is the half of it this shader reads.
//
// `Rtx::FogVolume` says why the filtered quantities and the integrated ones are different images.

#include "camera.h"
#include "scene.h"
#include "visibility.h"

#include "lib/bindings.glsl"
#include "lib/fog.glsl"
#include "lib/lights.glsl"
#include "lib/random.glsl"
#include "lib/reproject.glsl"
#include "lib/traversal.glsl"
#include "lib/underwater.glsl"
#include "lib/variants.glsl"

layout(local_size_x = FOG_VOLUME_WORKGROUP, local_size_y = FOG_VOLUME_WORKGROUP) in;

/// How much of a froxel's answer comes from where it stood last frame.
///
/// **Heavy, because what it is averaging is one jittered sample.** A froxel takes one point out of
/// its own volume, one shadow ray for its stretch and one lamp out of its cell; each is a draw, and
/// the mean of them is the answer. Nine tenths converges over about ten frames, which is a sixth of
/// a second — slow enough to hide the draw and quick enough that a lamp coming on is not a fade.
const float FOG_VOLUME_HISTORY = 0.9;

/// The air untouched, which is what a frame with no fog in it has to be exactly.
void clearColumn(ivec2 column)
{
    for (uint slice = 0u; slice < FOG_VOLUME_SLICES; ++slice)
    {
        const ivec3 at = ivec3(column, slice);

        imageStore(fogScatterTarget, at, vec4(0.0));
        imageStore(fogSunwardTarget, at, vec4(0.0));
        imageStore(fogVolumeAirTarget, at, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(fogVolumeSunwardTarget, at, vec4(0.0));
    }
}

/// Where a point `fromEye` in front of this eye stood in the previous frame's grid, or a coordinate
/// outside it where there is no answer.
vec3 fogVolumeWas(vec3 fromEye)
{
    const vec3 was = fromEye + frame.mCameraMotion;

    const vec2 screen = previousScreen(was);
    if (screen.x < 0.0)
        return vec3(-1.0);

    // Normalised by the image and never by the frame, for the reason `fogVolumeAlong` gives.
    const vec2 columns = vec2(textureSize(fogWasScatter, 0).xy);
    const vec2 at = screen * vec2(float(frame.mCamera.mWidth), float(frame.mCamera.mHeight))
        / float(FOG_VOLUME_SCALE) / columns;

    // The depth curve, inverted. A slice holds what its own jittered point read, so its texel centre
    // is the slice's middle and a distance reads straight off the curve with no half-texel shift —
    // which the *integrated* volume does need, because there a slice holds its far edge.
    const float along = sqrt(min(length(was), FOG_REACH) / FOG_REACH);

    return vec3(at, along);
}

void main()
{
    const ivec3 grid = imageSize(fogVolumeAirTarget);
    const ivec2 column = ivec2(gl_GlobalInvocationID.xy);
    if (column.x >= grid.x || column.y >= grid.y)
        return;

    // No air is the frame untouched, and it has to be exactly that: a lit surface with fog over it
    // is a differently lit one, and the tests that measure radiance turn this off.
    if (!(frame.mFogExtinction > 0.0))
    {
        clearColumn(column);
        return;
    }

    // **Three draws, turning frame to frame, and the filter above is what they are for.** One moves
    // the column's ray inside its own block of pixels, one moves each sample inside its slice, and
    // the third moves the shadow probe along its stretch. Read off one blue-noise stream at three
    // offsets, so neighbouring columns disagree about all three at once rather than in step.
    const float alongJitter = randomAt(uvec2(column), STREAM_FOG);
    const vec2 acrossJitter = vec2(randomAt(uvec2(column) + uvec2(17u, 5u), STREAM_FOG),
        randomAt(uvec2(column) + uvec2(3u, 29u), STREAM_FOG));

    // **The ray through a point inside the block this column stands for, from `rayAt`** — the same
    // call the trace makes from a pixel, so the two cannot disagree about where a column points.
    // Half a pixel back, because `rayAt` adds its own.
    const vec2 inside = (vec2(column) + acrossJitter) * float(FOG_VOLUME_SCALE) - 0.5;
    const Ray ray = rayAt(frame.mCamera, inside);
    const vec3 origin = frame.mOrigin + ray.mOffset;
    const vec3 direction = ray.mDirection;

    const FogSources sources = fogSourcesAlong(direction);

    // **The whole reach and not the distance to a surface**, which is the one thing a volume cannot
    // know: it is integrated before anything has been traced. The quadratic curve is what keeps the
    // near end from being coarse — a third of the slices land inside the first tenth of the reach.
    const float span = FOG_REACH;

    uint lampState = randomSeed(pixelKey(uvec2(column)) + SEED_LAMPS_FOG);

    float transmittance = 1.0;
    vec3 scattered = vec3(0.0);
    vec3 sunward = vec3(0.0);
    float behind = 0.0;

    for (uint stretch = 0u; stretch < FOG_SHADOW_RAYS; ++stretch)
    {
        // One ray for the whole stretch, from a point drawn anywhere along it — which is what
        // `FOG_SHADOW_RAYS` has always meant, and what makes eight probes stand for sixty-four
        // slices. Where along the stretch it leaves from turns every frame, so a shaft's edge lands
        // between two froxels as something the filter averages rather than as a staircase.
        float visible = 1.0;
        float lunar = 1.0;
        if (sources.mShafts || sources.mMoonlit)
        {
            const float reach
                = fogDepth(float((stretch + 1u) * FOG_VOLUME_SLICES_PER_RAY) / float(FOG_VOLUME_SLICES)) * span;
            const vec3 probe = origin + direction * mix(behind, reach, alongJitter);

            if (sources.mShafts)
                visible = lightThrough(probe, frame.mSunPosition, frame.mFar);
            if (sources.mMoonlit)
                lunar = lightThrough(probe, sources.mMoonward, frame.mFar);
        }

        for (uint k = 0u; k < FOG_VOLUME_SLICES_PER_RAY; ++k)
        {
            const uint slice = stretch * FOG_VOLUME_SLICES_PER_RAY + k;

            // **The boundaries are fixed and only the sample inside them moves.** The stride is what
            // the transmittance below is integrated over, so a jittered boundary would be a
            // different integral every frame rather than a different estimate of one.
            const float ahead = fogDepth(float(slice + 1u) / float(FOG_VOLUME_SLICES)) * span;
            const float stride = ahead - behind;

            const float at = behind + alongJitter * stride;
            const vec3 position = origin + direction * at;
            behind = ahead;

            // Everything below is a property of this *point* and of nothing along the ray, which is
            // what lets it be reprojected and averaged. The transmittance is applied afterwards.
            const float extinction = fogExtinctionAt(position, stride);

            // What any water overhead leaves of the daylight, asked once: both sources want it.
            const vec3 reaching = daylightReaching(position);

            const vec3 moons = sources.mMoonlit ? moonsInAir(extinction, sources, lunar, reaching) : vec3(0.0);

            // **Isotropic, and `INV_FOUR_PI` is what isotropic is.** A lamp arrives in the air as
            // irradiance exactly as it arrives at a surface, and what comes back toward the eye is
            // that irradiance spread over the sphere.
            Reservoir lamps = noLamps();
            weighLamps(lamps, lampState, position, vec3(0.0), INV_FOUR_PI, 0.0, false);

            vec3 inscatter = frame.mFogColour + moons
                + lampsThrough(lamps, vec2(randomNext(lampState), randomNext(lampState)));

            // **The sun without its irradiance and without its phase**, which is the whole of what
            // the second image is for: both are functions of the direction alone, so they factor out
            // of the integral exactly and the trace puts them back at the pixel's own angle rather
            // than the column's. Mie's forward peak is thousands of times isotropic within a degree
            // and a column is a quarter of one, so baking it here would smear the blaze around a low
            // sun over four times its width.
            vec3 transport = sources.mSunlit ? sunInAir(extinction, visible, reaching) : vec3(0.0);

            float density = extinction;

            const vec3 was = fogVolumeWas(direction * at);
            if (all(greaterThanEqual(was, vec3(0.0))) && all(lessThanEqual(was, vec3(1.0))))
            {
                const vec4 wasScatter = texture(fogWasScatter, was);
                const vec3 wasSunward = texture(fogWasSunward, was).xyz;

                inscatter = mix(inscatter, wasScatter.xyz, FOG_VOLUME_HISTORY);
                density = mix(density, wasScatter.w, FOG_VOLUME_HISTORY);
                transport = mix(transport, wasSunward, FOG_VOLUME_HISTORY);
            }

            const ivec3 texel = ivec3(column, slice);
            imageStore(fogScatterTarget, texel, vec4(inscatter, density));
            imageStore(fogSunwardTarget, texel, vec4(transport, 0.0));

            // What this slice is worth to the frame, computed once and used twice: what it scatters
            // in is weighted by it, and what the transmittance loses to it is exactly it, since
            // `T * (1 - absorbed)` is `T - T * absorbed`.
            const float weight = transmittance * (1.0 - exp(-density * stride));

            scattered += weight * inscatter;
            sunward += weight * transport;
            transmittance -= weight;

            // **The accumulation at the slice's far edge**, which is the depth `fogVolumeAlong`
            // resolves a distance to. Written here rather than gathered afterwards because the
            // column is one thread and the running pair is already in its registers.
            imageStore(fogVolumeAirTarget, texel, vec4(scattered, transmittance));
            imageStore(fogVolumeSunwardTarget, texel, vec4(sunward, 0.0));
        }
    }
}
