#version 460

#extension GL_GOOGLE_include_directive : require

// Which tiles of the screen each sprite can be met from, and how many sprites each tile holds.
//
// **Conservative by construction, and the trace's own test is what refines it.** A tile's list
// has to hold every sprite any ray through the tile could meet, because `spritesAlong` tests a
// sprite it is handed and never looks for one it was not — a sprite the binning drops is a raindrop
// that stops being drawn. So what is bounded here is exactly what the march tests against: a ball
// for a sprite that faces the eye, and for a quad hanging on an axis of its own the capsule that
// swinging its width about that axis sweeps. `Rtx::SceneDesc::addEmitter` says why the emitter's
// own sphere is the wrong granularity for this, and rain is what proved it.
//
// **A capsule and not a sphere around a quad's corners, and rain is why.** A drop is a long thin
// streak, so that sphere is as wide as the streak is long — tens of times the width — and a bound
// that wide holds the eye for every drop falling anywhere near the camera. A sphere that holds the
// eye is met from every direction, so each of those goes into every tile on the screen, and a few
// dozen drops are nearly the whole list. The capsule's radius is the streak's width instead of its
// length.

#include "spritebin.h"

#include "lib/spritelist.glsl"

layout(local_size_x = SPRITE_BIN_WORKGROUP) in;

layout(push_constant, scalar) uniform Push
{
    SpriteBinConstants bin;
};

/// The camera's axes, unit, beside the half-extents they were scaled by.
///
/// `makeCameraFromView` builds `mForward` unit and scales `mRight` and `mUp` by the image plane's
/// half-width and half-height, so the three are mutually orthogonal and the two lengths are the
/// only thing separating a direction from a screen coordinate.
struct Frame
{
    vec3 mForward;
    vec3 mRight;
    vec3 mUp;
    float mHalfWidth;
    float mHalfHeight;
};

Frame frameOf(Camera camera)
{
    Frame frame;
    frame.mForward = normalize(camera.mForward);
    frame.mHalfWidth = length(camera.mRight);
    frame.mHalfHeight = length(camera.mUp);
    frame.mRight = camera.mRight / frame.mHalfWidth;
    frame.mUp = camera.mUp / frame.mHalfHeight;

    return frame;
}

/// Where a screen coordinate in minus-one-to-one lands, in whole pixels and generously.
///
/// **A pixel of slack at each end, which is what covers the jitter.** `rayAt` adds half a pixel and
/// the frame's jitter to the index before scaling, and the jitter is a Halton offset inside the
/// pixel — so a coordinate is worth a pixel either way and the binning has to hold every ray the
/// tile can produce, not the one through its centre.
int toPixel(float coordinate, uint extent, float slack)
{
    return int(floor((coordinate + 1.0) * 0.5 * float(extent) + slack));
}

/// Where an orthographic frame sees a ball of `radius` about `centre`, in whole pixels, before the
/// frame's edges are applied: its first column and row in `xy`, its last in `zw`.
///
/// Every ray runs the same way and the eye slides across the plane instead, so the sphere covers
/// the coordinates whose ray passes within its radius. Behind the plane is still binned: the march's
/// own depth test is what rejects it, and this only has to be no tighter than that. **Off the frame
/// and not clipped to it**, because a capsule is bounded by two of these and a rectangle clipped to
/// nothing carries no side to union against.
ivec4 orthographicPixels(vec3 centre, float radius, Frame frame)
{
    const vec3 toward = centre - bin.mOrigin;

    const float lowU = (dot(toward, frame.mRight) - radius) / frame.mHalfWidth;
    const float highU = (dot(toward, frame.mRight) + radius) / frame.mHalfWidth;

    // `rayAt` subtracts the up axis, so a sprite above the eye is at a smaller `v`.
    const float lowV = (-dot(toward, frame.mUp) - radius) / frame.mHalfHeight;
    const float highV = (-dot(toward, frame.mUp) + radius) / frame.mHalfHeight;

    return ivec4(toPixel(lowU, bin.mCamera.mWidth, -1.0), toPixel(lowV, bin.mCamera.mHeight, -1.0),
        toPixel(highU, bin.mCamera.mWidth, 1.0), toPixel(highV, bin.mCamera.mHeight, 1.0));
}

/// The tiles one sprite reaches, as an inclusive rectangle, or nothing where it reaches none.
struct TileRect
{
    uvec2 mFrom;
    uvec2 mTo;
};

bool isEmpty(TileRect rect)
{
    return rect.mTo.x < rect.mFrom.x || rect.mTo.y < rect.mFrom.y;
}

/// A first past every last, which is what the table carries for it too: no tile count reaches
/// sixteen bits, so the pass over tiles tests it like any other rectangle and never matches.
TileRect noTiles()
{
    return TileRect(uvec2(0xFFFFu), uvec2(0u));
}

/// The tiles a pixel rectangle covers, or nothing where it misses the frame.
TileRect tilesOf(ivec4 rect)
{
    const int width = int(bin.mCamera.mWidth);
    const int height = int(bin.mCamera.mHeight);

    if (rect.z < 0 || rect.w < 0 || rect.x >= width || rect.y >= height)
        return noTiles();

    const ivec4 held = clamp(rect, ivec4(0), ivec4(width - 1, height - 1, width - 1, height - 1));

    return TileRect(uvec2(held.xy) / SPRITE_TILE, uvec2(held.zw) / SPRITE_TILE);
}

/// Everywhere a sprite's own drawing can reach, as a segment and a radius about it.
///
/// **A ball for a billboard and a capsule for an oriented quad**, because that is the shape the
/// march tests against. A billboard is rejected past `mRadius` of the ray, so the ball is exact. An
/// oriented quad hangs on the axis its own particle carries and swings its width about that axis
/// to meet the ray — so over every direction the eye can look from, it sweeps a cylinder of the
/// width's radius about the axis segment, and the capsule is that cylinder with its ends rounded.
struct Bound
{
    vec3 mFrom;
    vec3 mTo;
    float mRadius;
    bool mOriented;
};

Bound boundOf(GpuSprite sprite, GpuEmitter emitter)
{
    Bound bound;
    bound.mOriented = emitter.mWidth > 0.0;
    if (!bound.mOriented)
    {
        bound.mFrom = sprite.mPosition;
        bound.mTo = sprite.mPosition;
        bound.mRadius = sprite.mRadius;

        return bound;
    }

    const vec3 reach = sprite.mAxis * sprite.mRadius;
    bound.mFrom = sprite.mPosition - reach;
    bound.mTo = sprite.mPosition + reach;
    bound.mRadius = sprite.mRadius * emitter.mWidth;

    return bound;
}

/// Half the angle a disc of `radius` about `centre` fills as seen from the eye, in one plane
/// through the eye: a right angle where the eye stands inside it.
float spreadOf(vec2 centre, float radius)
{
    return asin(min(radius / length(centre), 1.0));
}

/// How far the eye stands from the segment between `from` and `to`, in the same plane.
float distanceToSegment(vec2 from, vec2 to)
{
    const vec2 along = to - from;
    const float share = dot(along, along) > 0.0 ? clamp(-dot(from, along) / dot(along, along), 0.0, 1.0) : 0.0;

    return length(from + along * share);
}

/// The screen coordinate along an axis whose half-extent is `halfExtent` of the direction `angle` from
/// the view, held to two either side: a right angle or past it is the frame's edge on that side,
/// chosen before the tangent is taken, so what it makes of a right angle `PI` rounds to either side
/// of is never what comes back.
float coordinateOf(float angle, float halfExtent)
{
    const float quarter = 0.5 * PI;
    return angle <= -quarter ? -2.0 : angle >= quarter ? 2.0 : clamp(tan(angle) / halfExtent, -2.0, 2.0);
}

/// The screen coordinates, in minus one to one, that the rays meeting a capsule take along one axis
/// of a perspective frame: the lowest in `x` and the highest in `y`, held to two either side, so a
/// side that reaches past the frame lands off it, and `x` past `y` where the frame sees none of it.
/// `from` and `to` are the caps' centres as `(across, depth)` in the plane of the axis and the view
/// direction, where an angle is taken from the view direction towards `across`.
///
/// **The arc of directions and not the tangent lines' slopes**, because a slope stands for a
/// direction only in front of the eye. The capsule's cross-section in that plane is the stadium
/// about the segment between the caps, and seen from outside it the directions that meet it are one
/// arc under a half turn, whose two ends are tangent to the caps' discs. So the second cap's wedge is
/// turned the short way to the first's, and the arc runs from the lower end of the two to the
/// higher. The frame sees the half turn about the view direction; the arc, or its copy a whole turn
/// round, meets it at most once, and an end past the right angle is the frame's edge.
///
/// **Only where the eye stands inside the stadium is every coordinate reached**, and not wherever a
/// cap reaches the plane through the eye: that plane runs out sideways for ever, and the snow falling
/// level with the camera, however far to the side and whether or not the frame can see it, sent
/// everywhere is 141 sprites in every tile of a 2560x1440 frame at Nivalis, each walked by the trace
/// and the composite at every pixel.
vec2 capsuleSpan(vec2 from, vec2 to, float radius, float halfExtent)
{
    const float quarter = 0.5 * PI;
    const float whole = 2.0 * PI;

    const float towards = atan(from.x, from.y);
    float turn = atan(to.x, to.y) - towards;
    turn -= whole * round(turn / whole);

    const float spread = spreadOf(from, radius);
    const float otherSpread = spreadOf(to, radius);
    const float lowest = towards + min(-spread, turn - otherSpread);
    const float highest = towards + max(spread, turn + otherSpread);

    float low = quarter;
    float high = -quarter;
    for (int copy = -1; copy <= 1; ++copy)
    {
        const float shift = whole * float(copy);
        const float seenFrom = max(lowest + shift, -quarter);
        const float seenTo = min(highest + shift, quarter);
        const bool meets = seenFrom < seenTo;
        low = meets ? min(low, seenFrom) : low;
        high = meets ? max(high, seenTo) : high;
    }

    // An arc the frame sees none of leaves its two ends where they started, past each other at the
    // frame's two edges, and the span they make is empty.
    const bool inside = distanceToSegment(from, to) <= radius;
    return vec2(coordinateOf(inside ? -quarter : low, halfExtent), coordinateOf(inside ? quarter : high, halfExtent));
}

/// The tiles a capsule can be met from.
///
/// **In perspective, the span each screen axis sees, and one rectangle across the two**, because a
/// ray meets the capsule only where both of its coordinates do. Orthographic, the rectangle around
/// the two balls that cap it: a streak lying across the frame covers a long thin rectangle, and a
/// ball holding the same two ends covers the square that rectangle sits in.
TileRect capsuleTiles(Bound bound, Frame frame)
{
    if (bin.mCamera.mOrthographic != 0u)
    {
        ivec4 rect = orthographicPixels(bound.mFrom, bound.mRadius, frame);
        if (bound.mOriented)
        {
            const ivec4 other = orthographicPixels(bound.mTo, bound.mRadius, frame);
            rect = ivec4(min(rect.xy, other.xy), max(rect.zw, other.zw));
        }

        return tilesOf(rect);
    }

    const vec3 from = bound.mFrom - bin.mOrigin;
    const vec3 to = bound.mTo - bin.mOrigin;
    const float fromDepth = dot(from, frame.mForward);
    const float toDepth = dot(to, frame.mForward);

    const vec2 sideways = capsuleSpan(vec2(dot(from, frame.mRight), fromDepth), vec2(dot(to, frame.mRight), toDepth),
        bound.mRadius, frame.mHalfWidth);

    // `rayAt` subtracts the up axis, so a sprite above the eye is at a smaller `v`.
    const vec2 upright = capsuleSpan(vec2(-dot(from, frame.mUp), fromDepth), vec2(-dot(to, frame.mUp), toDepth),
        bound.mRadius, frame.mHalfHeight);

    return tilesOf(ivec4(toPixel(sideways.x, bin.mCamera.mWidth, -1.0), toPixel(upright.x, bin.mCamera.mHeight, -1.0),
        toPixel(sideways.y, bin.mCamera.mWidth, 1.0), toPixel(upright.y, bin.mCamera.mHeight, 1.0)));
}

void main()
{
    const uint sprite = gl_GlobalInvocationID.x / SPRITE_BIN_LANES;
    const uint lane = gl_LocalInvocationID.x % SPRITE_BIN_LANES;
    if (sprite >= bin.mCount)
        return;

    const GpuSprite held = SpriteTable(bin.mSprites).at[sprite];
    const GpuEmitter emitter = EmitterTable(bin.mEmitters).at[held.mEmitter];

    const uint across = spriteTilesOver(bin.mCamera.mWidth);

    // Every lane of the sprite works its rectangle out for itself: a dozen operations against a
    // shared-memory exchange and the barrier that would order it.
    const TileRect rect = capsuleTiles(boundOf(held, emitter), frameOf(bin.mCamera));

    if (lane == 0u)
        SpriteRects(bin.mRects).at[sprite] = packSpriteRect(rect.mFrom, rect.mTo);

    if (isEmpty(rect))
        return;

    const uint wide = rect.mTo.x - rect.mFrom.x + 1u;
    const uint area = wide * (rect.mTo.y - rect.mFrom.y + 1u);

    for (uint cell = lane; cell < area; cell += SPRITE_BIN_LANES)
    {
        const uint x = rect.mFrom.x + cell % wide;
        const uint y = rect.mFrom.y + cell / wide;

        atomicAdd(SpriteTileList(bin.mList).at[spriteCountSlot(y * across + x)], 1u);
    }
}
