#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_shader_invocation_reorder : require

// The frame, composed. One ray per pixel against the top-level structure; what a pixel *shows* is
// answered by whichever shader the hit table names, and this is the order those answers are put
// together in — the water under the air, the puffs left in a layer of their own, and each of the
// G-buffer channels given what its reader was promised.
//
// **The traversal and the shading are two programs.** The launch traces a hit object and then runs
// the shader that object names, which traversal picked off the instance's own shader-table offset;
// what comes back is a payload rather than a `Surface`. So this shader holds no lamp reservoir, no
// bounce, no layer stack and no sky — each of those is in the shader that needs it, carrying its own
// registers. `lib/payload.glsl` is what crosses.
//
// **What is left here is what belongs to the path rather than to the surface**: the layers the eye
// looks through, the column of water in front of them, the air, the cloud shells, and the
// channels.

#include "camera.h"
#include "scene.h"
#include "visibility.h"

#include "lib/bindings.glsl"
#include "lib/fog.glsl"
#include "lib/frame.glsl"
#include "lib/medium.glsl"
#include "lib/payload.glsl"
#include "lib/random.glsl"
#include "lib/reproject.glsl"
#include "lib/shading.glsl"
#include "lib/sprites.glsl"
#include "lib/traversal.glsl"
#include "lib/underwater.glsl"
#include "lib/water.glsl"

layout(location = RTX_PAYLOAD) rayPayloadEXT VisibilityPayload packed;

/// What crosses traversal, which is nothing anything reads. `RTX_TRAVERSAL_PAYLOAD` says why it
/// exists at all: the any-hit shader a traversal reaches wants a smaller payload than the shader
/// the execute runs, and this is how small.
layout(location = RTX_TRAVERSAL_PAYLOAD) rayPayloadEXT uint traversed;

/// Where on its triangle the hit object's ray landed, read back off the object for the motion
/// vector of a surface that deforms: `hitObjectGetAttributesEXT` writes here and nowhere else.
/// A literal at the call, as `RTX_PAYLOAD` is.
#define RTX_LANDED 0
layout(location = RTX_LANDED) hitObjectAttributeEXT vec2 landed;

/// What the media in front of a point along the ray scattered in, and what they let through.
struct MediumAhead
{
    vec3 mScattered;
    vec3 mThrough;
};

/// The water in front of a point and the air over the whole of it, put together.
///
/// **One composition for the whole path and for every layer peeled off it**, because those are the
/// same measurement over different stretches: the water first and the air over what it left, in
/// that order and nowhere else. Each layer's pair is then a prefix of the path's own — the air is
/// one accumulation read twice and the water march is handed the same offset — so the two agree
/// where they meet by construction rather than by tolerance.
///
/// @param air how far the fog is measured over. Its own march clamps this to the reach.
/// @param water,width the stretch of water the column march takes and how wide the ray's cone is at
///        the end of it. Not the same as `air` for a ray that escaped, which carries `mFar` for its
///        distance and no cone at all — `WATER_UNBOUNDED_PATH` is what such a ray crossed.
MediumAhead mediumAhead(uvec2 pixel, vec3 origin, vec3 direction, float air, float water, float width, bool submerged)
{
    MediumAhead ahead = MediumAhead(vec3(0.0), vec3(1.0));

    if (submerged)
    {
        const WaterColumn column = waterColumn(origin, direction, water, width, randomAt(pixel, STREAM_WATER));

        ahead.mScattered = column.mScattered;
        ahead.mThrough = column.mTransmittance;
    }

    const vec4 fog = fogAlong(pixel, origin, direction, air);

    ahead.mScattered = ahead.mScattered * fog.w + fog.xyz;
    ahead.mThrough *= fog.w;

    return ahead;
}

/// Traces one ray and runs the shader the hit names.
///
/// **A macro because a `hitObjectEXT` may not cross a function boundary**, which is the same
/// restriction `RTX_TRAVERSE` is written around for `rayQueryEXT`.
///
/// **Two payloads, because the two calls invoke different shaders.** Traversal reaches the any-hit
/// shader, which tests a cutout and reads nothing; the execute reaches a closest-hit or the miss
/// shader, which fills in the whole of what the frame's tail needs. The whitepaper names this
/// exactly — an any-hit wants a smaller payload than a closest-hit, and giving it the larger one is
/// register pressure paid for fields the invoked shader never touches.
///
/// **One call reached by every invocation.** A miss is a hit object like any other, so the sky's
/// shader runs through the same execute as the solids'.
///
/// @param object filled in with what the ray found, and left readable: the launch takes the ray,
///        the distance and the instance row back off it rather than carrying them.
/// @param layer which layer of the peel this trace is for, counting the eye's own as nought. Added
///        to the instance's shader-table offset, so the hit lands on the record that says so —
///        `HitRecord` in `visibility.h` says why it travels that way and not in the payload.
#define RTX_TRACE(object, from, tmin, along, mask, layer)                                                   \
    hitObjectTraceRayEXT(object, sceneTop, gl_RayFlagsNoneEXT, (mask), (layer), 0u, MISS_RECORD_SKY, (from), \
        (tmin), (along), frame.mFar, RTX_TRAVERSAL_PAYLOAD);

/// Runs the shader the hit object names, sorted first where the build asked.
///
/// **The one place the launch's threads may be reordered, and why it is a constant.** Between
/// the trace and the execute the hit object says which shader each thread is about to run, and
/// `reorderThreadEXT` groups the threads that agree so a warp runs one shader rather than three
/// — the shader index is the key the driver sorts on with no hint at all. What crosses it is
/// the payload the execute fills afterwards, so nothing is written into it before this; the
/// driver note in `visibility.h` is what that keeps out. `REORDER` is `RenderProfile::mReorder`.
#define RTX_SHADE(object)                                                                                   \
    {                                                                                                       \
        if (REORDER == REORDER_SHADER)                                                                      \
            reorderThreadEXT(object);                                                                       \
        else if (REORDER == REORDER_TEXTURE)                                                                \
            reorderThreadEXT(object, textureHintOf(object), 8);                                             \
        hitObjectExecuteShaderEXT(object, RTX_PAYLOAD);                                                     \
    }

#define RTX_TRACE_AND_SHADE(object, from, tmin, along, mask, layer)                                         \
    {                                                                                                       \
        RTX_TRACE(object, from, tmin, along, mask, layer)                                                   \
        RTX_SHADE(object)                                                                                   \
    }

/// The low eight bits of the diffuse texture slot the hit's material names, as a coherence hint:
/// two dependent loads the hit shader makes again, spent here so that a warp reads one sheet.
/// Nought for a miss, which names no material.
uint textureHintOf(hitObjectEXT object)
{
    if (!hitObjectIsHitEXT(object))
        return 0u;

    return materialAt(instanceAt(uint(hitObjectGetInstanceCustomIndexEXT(object))).mMaterial).mDiffuse & 0xFFu;
}

void main()
{
    // **The launch is the frame, so there is no tail to test for.** A dispatch covered the picture
    // in whole workgroups and every one of them had to ask whether it had run off the edge;
    // `vkCmdTraceRaysKHR` is handed the width and the height themselves.
    const uvec2 pixel = gl_LaunchIDEXT.xy;

    // **Traversal picks the shader and this shader never asks what it hit.** The instance carries
    // its material's kind as its shader-table offset, so the hit object comes back naming one of the
    // closest-hit records or the sky's miss record.
    //
    // **The ray is built into the call and not kept.** The same rays the wavelet rebuilds come from
    // the same `rayAt`, and the hit object hands them back below.
    //
    // **The arms first, through their own eye, and the world only where they are not.** The
    // rasterizer draws the player's arms under a projection of their own field of view and clears
    // the depth under them, so they stand in front of everything — a decision about what the
    // picture is, which `worldMask` says the world's ray keeps out of. The arms' ray is traced and
    // not shaded until it is known to have hit, so a pixel beside the arms pays one traversal on
    // a mask a handful of instances carry and no second shading of the sky.
    hitObjectEXT found;
    bool arms = false;
    if (frame.mArmsInFrame != 0u)
    {
        const Ray ray = rayAt(frame.mArms, vec2(pixel));
        RTX_TRACE(found, frame.mOrigin + ray.mOffset, 0.0, ray.mDirection, frame.mRayMask & MASK_FIRST_PERSON, 0u)
        arms = hitObjectIsHitEXT(found);
    }
    if (!arms)
    {
        const Ray ray = rayAt(frame.mCamera, vec2(pixel));
        RTX_TRACE(found, frame.mOrigin + ray.mOffset, 0.0, ray.mDirection, worldMask(frame.mRayMask), 0u)
    }
    RTX_SHADE(found)
    Answer answer = unpackAnswer(packed);

    // What every ray after the eye's own casts with along this pixel's ray: past the arms, the
    // peel may meet the world behind them as well as the next layer of them.
    const uint peelMask = arms ? frame.mRayMask : worldMask(frame.mRayMask);

    // **Read back rather than carried across.** The hit object holds the ray it was traced with, so
    // asking it costs nothing where six floats of the launch's own would have been kept live across
    // the execute.
    vec3 origin = hitObjectGetWorldRayOriginEXT(found);
    vec3 direction = hitObjectGetWorldRayDirectionEXT(found);

    bool hit = hitObjectIsHitEXT(found);
    float distance = hitObjectGetRayTMaxEXT(found);
    uint instance = hitObjectGetInstanceCustomIndexEXT(found);

    // **Made before the peel, because each layer of it is charged the medium in front of itself.**
    // Both are the eye's own and neither moves as the ray carries on past a layer: the cone is the
    // eye's the ray was cast from, and what stands over the eye is what the eye stands in.
    const Cone cone = arms ? coneAt(frame.mArms) : coneAt(frame.mCamera);
    const bool submerged = waterOver(origin) > 0.0;

    // **The surfaces the eye is looking through, peeled off nearest first and kept.** A pane of
    // glass is one, and so is an actor the game is fading — Invisibility, Chameleon, or the distance
    // fade at the edge of `actors processing range`. Each was met like any other surface and lit
    // like any other, and the ray carries on from where it stood, so what is behind it is a real hit
    // rather than whatever its mask happened to survive a cutoff.
    //
    // **A stack and not one layer, because a person is a stack.** A cuirass over a skirt over a leg
    // is three surfaces, and peeling only the nearest showed one of them faded and the two under it
    // at full strength — an actor under Chameleon wearing a solid body. `PEEL_LAYERS` is the budget
    // and the record a trace past it lands on is how the shader there is told to draw a solid, so a
    // deeper stack ends in the surface standing there rather than in a hole.
    //
    // **The stack was counted rather than assumed** when the budget was set: Red Mountain holds 205
    // translucent materials and its deepest ray crossed eight of them, and those are the medium's —
    // a surface that is nowhere opaque never stops a ray at all and is gathered by `mediumAlong`
    // instead, so what reaches here is glass and clothing.
    //
    // **The composite is the ordered one, back to front by construction.** Each layer keeps what
    // every layer in front of it let through, which is one multiply a layer and no sorting: the ray
    // meets them in depth order and cannot meet them in any other.
    //
    // **And each of them over the medium in front of *it*.** A layer is a lit surface standing part
    // of the way along the path, so what it arrives at the eye as is its own radiance over the air
    // and the water short of it — `mediumAhead`. Charged the medium in front of the nearest layer
    // instead, a glowing window three thousand units off behind a pane at one thousand read as
    // though it stood at one thousand, and moving it along the path changed nothing at all: the same
    // fault the split below was written for, one layer deeper.
    //
    // **Their motion vector, their depth and the guide the upscaler demodulates by all stay the
    // surface behind them**, which is right while the stack is mostly see-through and wrong as it
    // approaches opaque. A motion vector of the pane's own is what answering that properly looks
    // like, and no pane in the game is near enough to opaque to have earned one.
    vec3 paneRadiance = vec3(0.0);
    float paneThrough = 1.0;

    // What the medium in front of the last layer peeled scattered in, which the surface behind the
    // stack is measured against below. Nothing at all where nothing was peeled.
    vec3 peeledScattered = vec3(0.0);

    for (uint layer = 0u; layer < PEEL_LAYERS && hit && !answer.mWater && isSeenThrough(answer.mOpacity); ++layer)
    {
        const MediumAhead ahead = mediumAhead(
            pixel, origin, direction, distance, distance, cone.mWidth + cone.mSpread * distance, submerged);

        // The stretch of medium since the layer in front of this one, and then this layer over
        // everything short of it — both behind whatever the layers in front of it left.
        paneRadiance += paneThrough
            * (ahead.mScattered - peeledScattered + ahead.mThrough * (answer.mRadiance * answer.mOpacity));

        paneThrough *= 1.0 - answer.mOpacity;
        peeledScattered = ahead.mScattered;

        // The layer this trace is for, which on the last one the budget allows is the record that
        // says whatever it finds is to be shaded as a solid.
        RTX_TRACE_AND_SHADE(found, origin, distance + SHADOW_BIAS, direction, peelMask, layer + 1u)
        answer = unpackAnswer(packed);

        origin = hitObjectGetWorldRayOriginEXT(found);
        direction = hitObjectGetWorldRayDirectionEXT(found);

        hit = hitObjectIsHitEXT(found);
        distance = hitObjectGetRayTMaxEXT(found);
        instance = hitObjectGetInstanceCustomIndexEXT(found);
    }

    // **The last shader's answer, unpacked once.** `answer` holds what the surface behind the
    // stack sent back, and everything below composes over it; the rest of it is read at the
    // stores, and nothing between here and there changes it.
    vec3 shaded = answer.mRadiance;

    // **What the surface is, kept apart from what the path did to it.** An albedo multiplied by
    // every transmittance on the way to the eye is what the composite wants back and is not what
    // an upscaler demodulates by: a foggy wall reporting an albedo with the fog in it is Ray
    // Reconstruction dividing the light by the wrong number wherever there is weather — which
    // outdoors is nearly everywhere.
    vec3 transmittance = vec3(1.0);

    // A camera under the surface sees everything through the water in front of it, **the surface
    // included**. What the water's own shader attenuated is each of its own rays over its own
    // stretch — the reflection back down into the water, the refraction through the air above — and
    // the stretch from the eye up to the surface is a different one that nothing else pays. Leaving
    // it out is what made the same column read one way from above and another from below: a ray
    // aimed up from a hundred units down found the surface exactly as bright as one aimed up from
    // ten.
    //
    // The air stands over all of it, which is the order `mediumAhead` composes them in: everything
    // else in the frame is what the fog stands between the eye and, the water's own absorption
    // included.
    //
    // Applied to the whole colour rather than to the albedo alone — what the depth took is a
    // property of the path, so it belongs to the modulation and not to the material.
    //
    // **An escaped ray carries neither of the two numbers a column is measured with**: it kept
    // `mFar` for its distance and nought for its cone. What an unbounded one crossed is the whole
    // column, read at the width a cone that far out has — which is wider than any wave, so the
    // shaft march finds no pattern there to resolve.
    const bool unbounded = waterUnbounded(hit, origin, direction);
    const float crossed = unbounded ? WATER_UNBOUNDED_PATH : distance;
    const float width = hit || unbounded ? cone.mWidth + cone.mSpread * crossed : 0.0;

    const MediumAhead whole = mediumAhead(pixel, origin, direction, distance, crossed, width, submerged);

    shaded = shaded * whole.mThrough + whole.mScattered;
    transmittance *= whole.mThrough;

    // **The stack over what it stands in front of, after the water and the air.** Both of those are
    // measured over the distance to the surface *behind* the glass, and the stack stands part of the
    // way along that path: composited before them it is charged for the whole of it, and a lit
    // window a few units out arrives as dim as the room two hundred units behind it.
    //
    // **What each layer is charged is a prefix of the whole path, so every split is exact.** With
    // `S` for what `shaded` holds and `Llast` for what the medium in front of the last layer
    // scattered,
    //
    //     S      = Lwhole + Twhole * behind
    //     wanted = <the layers, each over its own prefix> + paneThrough * (Lwhole - Llast + Twhole * behind)
    //
    // and the second line is `paneRadiance + paneThrough * (S - Llast)`, since `paneRadiance` holds
    // every layer with the medium short of it and the air between the layers already in it. It is
    // the same identity the puff layer below splits the air by, for the same reason.
    //
    // The clamp is what a pair quantised apart by a froxel slice can need and a prefix cannot.
    shaded = paneRadiance + paneThrough * max(shaded - peeledScattered, vec3(0.0));

    transmittance *= paneThrough;

    // **The puffs in front of all of it, lit where they stand and left in a layer of their own.**
    // Nothing of them is in `shaded`: the frame goes to the denoiser with no puff in it, and
    // `spritecomposite.rgen` puts the layer over the reconstructed frame at the shown extent —
    // with the sprites' shape marched again there, at the picture's own resolution, and the
    // colour taken from here. What this walk is for is the light: three fetches a covering sprite
    // and a band of forty hashes an emitter, which is worth paying once at the traced extent and
    // not three times over at the shown one.
    //
    // **Two walks and one layer.** An emitter's sprites and a cloud's shells are the same kind of
    // thing standing in the same place, so the second walk fills a layer of its own and
    // `mergedPuffs` puts the two together. The shells' own transmittance rides beside the depth,
    // because the composite marches the sprites again and the shells it cannot.
    //
    // **And the whole of the second walk is inside the test.** `mMediumInFrame` says whether
    // anything at all carries `MASK_MEDIUM`, so a cell with no cloud in it neither descends the
    // top level to find nothing nor merges a layer that holds nothing — and the merge is not
    // free: it divides a coverage back out, which moves a level on a view that holds no medium.
    PuffLayer layer = spritesAlong(pixel, cone, origin, direction, distance, true);
    float shellsThrough = 1.0;

    if (frame.mMediumInFrame != 0u)
    {
        const PuffLayer shells = mediumAlong(pixel, origin, direction, distance, cone);
        shellsThrough = shells.mTransmittance;
        layer = mergedPuffs(layer, shells);
    }

    // And which eye this pixel's ray was cast from, for the composite to march its own again
    // through the same one: `spritecomposite.rgen` reads it beside the depth.
    imageStore(puffs, ivec2(pixel), vec4(layer.mColour, layer.mTransmittance));
    imageStore(puffsDepth, ivec2(pixel), vec4(layer.mCoveredAt, shellsThrough, arms ? 1.0 : 0.0, 0.0));

    // **The sun glare fader's query, one ray at a time.** The rasterizer draws the sun's quad
    // against the world's depth and counts the pixels that survived; here every primary ray inside
    // the quad's disc counts itself, and again where nothing that writes depth stood in front of
    // the sky — the water writes none, and a pane peeled off the ray does. `glare.h` says whose
    // disc this is and `tone.comp` reads the pair back. The chord and not the angle, as the sun's
    // own disc is tested.
    if (sunUp() && length(direction - frame.mSun.mDirection) < 2.0 * sin(0.5 * SUN_GLARE_QUERY_RADIUS))
    {
        atomicAdd(sunGlare.mTotal, 1u);
        if (!(hit && !answer.mWater) && paneThrough >= 1.0)
            atomicAdd(sunGlare.mSeen, 1u);
    }

    const ivec2 at = ivec2(pixel);

    // **Coverage rides in the direct channel's alpha**, which every pass after this carries
    // through untouched: it is one everywhere but in a picture that has to say where it stops.
    const float coverage = (frame.mTransparentBackground != 0u && !hit) ? 0.0 : 1.0;
    imageStore(direct, at, vec4(shaded, coverage));

    // **The bounce carries what the path took off it, and the albedo carries only the surface.**
    // The composite still multiplies the two, so the picture is the same product it always was; what
    // moved is which of the two the water and the air are folded into. They belong to the light,
    // which is what they attenuated — and the channel that is left is then the albedo an upscaler
    // asks for.
    //
    // Filtering the bounce with the transmittance already in it averages a quantity that varies as
    // slowly as fog does, which is to say it changes nothing.
    imageStore(indirect, at, vec4(answer.mBounced * transmittance, 1.0));
    imageStore(albedo, at, vec4(answer.mResponse.mDiffuse, 1.0));
    imageStore(specular, at, vec4(answer.mResponse.mSpecular, 1.0));
    imageStore(guide, at, vec4(answer.mResponse.mNormal, answer.mResponse.mRoughness));

    // **The sky moves too, and only its turn moves it.** `skyMotionOf` says why storing nothing here
    // is a smear across every camera rotation. The frame's own vector, always: no puff is in the
    // frame, so nothing in it moves with a puff.
    // Projected through the eye it was found by: the arms' plane is wider than the world's by
    // `mArmsSpread`, and a point on them reprojects through that.
    // A deforming surface says where its own triangle stood, off the hit object: the primitive,
    // the barycentrics and the instance's basis all ride on it, so nothing crosses the payload.
    vec2 moved;
    if (hit)
    {
        hitObjectGetAttributesEXT(found, RTX_LANDED);
        moved = motionOf(pixel, origin, direction, distance, instance, uint(hitObjectGetPrimitiveIndexEXT(found)),
            landed, hitObjectGetObjectToWorldEXT(found), arms ? frame.mArmsSpread : vec2(1.0));
    }
    else
        moved = skyMotionOf(pixel, direction);
    imageStore(motion, at, vec4(moved, 0.0, 0.0));

    // **The one surface in this frame that shows something standing somewhere else.** Water is
    // shaded where it is seen, so the vector above describes the surface and not what is in it; this
    // is the other one, and the upscaler weighs the two by the specular albedo it was already given.
    imageStore(reflectionMotion, at,
        vec4(answer.mWater ? mirrorMotionOf(pixel, origin, answer.mMirror) : vec2(0.0), 0.0, 0.0));

    // **What the display pass has to draw the star field through**, which is everything this frame
    // put between the field and the eye: the sky's own layers in `skyShown`, and the pane, the
    // water and the air in the transmittance the light itself was already taken down by. The puffs
    // are not here: the composite leaves theirs in the frame's alpha for the same pass.
    // `starsShown` in `bindings.glsl` says why that pass cannot work any of it out for itself.
    imageStore(starsShown, at, vec4(answer.mSkyShown * transmittance, 1.0));

    // A miss is as far away as anything can be, and the hit object already carries `mFar` for it.
    // The arms' depth is the eye's own: `clipDepth` measures along the forward the two share.
    imageStore(depth, at, vec4(hit ? clipDepth(direction, distance) : 1.0, distance, 0.0, 0.0));
}
