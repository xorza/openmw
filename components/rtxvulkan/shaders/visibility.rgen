#version 460

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_shader_invocation_reorder : require
#extension GL_EXT_ray_tracing_position_fetch : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// The frame, composed. One ray per pixel against the top-level structure; what a pixel *shows* is
// answered by whichever shader the hit table names, and this is the order those answers are put
// together in — the water under the air, the air under the sprites, and each of the G-buffer
// channels given what its reader was promised.
//
// **The traversal and the shading are two programs now, and the reorder stands between them.** The
// launch traces a hit object, sorts the threads on the shader that object names, and then runs it;
// what comes back is a payload rather than a `Surface`. So this shader holds no lamp reservoir, no
// bounce, no layer stack and no sky — each of those is in the shader that needs it, carrying its own
// registers. `lib/payload.glsl` is what crosses.
//
// **What is left here is what belongs to the path rather than to the surface**: the pane the eye
// looks through, the column of water in front of it, the air, the sprites, and the eleven channels.

// **Before anything is included.** `lib/reorder.glsl` declares calls only a ray generation shader
// may make, and it is reached from a compute shader as well.
#define RTX_REORDERING

#include "camera.h"
#include "scene.h"
#include "visibility.h"

#include "lib/bindings.glsl"
#include "lib/fog.glsl"
#include "lib/frame.glsl"
#include "lib/payload.glsl"
#include "lib/random.glsl"
#include "lib/reorder.glsl"
#include "lib/reproject.glsl"
#include "lib/shading.glsl"
#include "lib/sprites.glsl"
#include "lib/traversal.glsl"
#include "lib/underwater.glsl"
#include "lib/water.glsl"

layout(location = RTX_PAYLOAD) rayPayloadEXT VisibilityPayload answer;

/// What crosses traversal, which is nothing anything reads. `RTX_TRAVERSAL_PAYLOAD` says why it
/// exists at all: the any-hit shader a traversal reaches wants a smaller payload than the shader
/// the execute runs, and this is how small.
layout(location = RTX_TRAVERSAL_PAYLOAD) rayPayloadEXT uint traversed;

/// Which rays the eye casts. The eye alone asks for the first-person arms; `MASK_FIRST_PERSON` says
/// why nothing else does.
const uint EYE_MASK = MASK_SOLID | MASK_WATER | MASK_FIRST_PERSON;

void main()
{
    // **The launch is the frame, so there is no tail to test for.** A dispatch covered the picture
    // in whole workgroups and every one of them had to ask whether it had run off the edge;
    // `vkCmdTraceRaysKHR` is handed the width and the height themselves.
    const uvec2 pixel = gl_LaunchIDEXT.xy;

    // **Traversal picks the shader and this shader never asks what it hit.** The instance carries
    // its material's kind as its shader-table offset, so the hit object comes back naming one of the
    // three closest-hit records or the sky's miss record — and that name is the sort's first key.
    //
    // **The ray is built into the call and not kept.** Live state is what a reorder costs, and the
    // sources say to spend it on nothing that can be had another way: the same rays the wavelet
    // rebuilds come from the same `rayAt`, and the hit object hands them back below.
    hitObjectEXT found;
    answer.mAsked = 0u;
    {
        const Ray ray = rayAt(frame.mCamera, vec2(pixel));
        RTX_TRACE_AND_SHADE(found, frame.mOrigin + ray.mOffset, 0.0, ray.mDirection, EYE_MASK)
    }

    // **Read back rather than carried across.** The hit object holds the ray it was traced with, so
    // asking it costs nothing that was not already migrated with the sort — where six floats of the
    // launch's own would have been spilled and restored beside it.
    vec3 origin = hitObjectGetWorldRayOriginEXT(found);
    vec3 direction = hitObjectGetWorldRayDirectionEXT(found);

    bool hit = hitObjectIsHitEXT(found);
    float distance = hitObjectGetRayTMaxEXT(found);
    uint instance = hitObjectGetInstanceCustomIndexEXT(found);

    vec3 shaded = answer.mRadiance;
    vec3 bounced = answer.mBounced;
    SurfaceResponse response = answer.mResponse;
    WaterMirror mirror = answer.mMirror;
    float skyShown = answer.mSkyShown;
    bool water = answer.mWater;

    // **The nearest surface the eye is looking through, peeled off and kept.** A pane of glass is
    // one, and so is an actor the game is fading — Invisibility, Chameleon, or the distance fade at
    // the edge of `actors processing range`. It was met like any other surface and lit like any
    // other, and now the ray carries on from where it stood, so what is behind it is a real hit
    // rather than whatever its mask happened to survive a cutoff.
    //
    // **The nearest one only.** A second one behind the first is drawn as the cutout it was, which
    // is what one layer buys: no sorting, no budget, and no second traversal on a pixel that has
    // nothing see-through in it. For glass that is nearly always the whole answer — the census says
    // a cell holds two to four translucent materials — and where it is, this is exact. `ASK_BEHIND`
    // is how the second shader is told which of the two it is.
    //
    // **An actor is not that.** A cuirass over a skirt over a leg is three layers, so a person under
    // Chameleon shows the nearest one faded and the one behind it at full strength. That is what an
    // ordered walk would buy, and it is the reason this says *to begin with*.
    //
    // **Its motion vector, its depth and the guide the upscaler demodulates by all stay the surface
    // behind it**, which is right while a pane is mostly see-through and wrong as it approaches
    // opaque. `SpriteClaim` is what answering that properly looks like, and no pane in the game is
    // near enough to opaque to have earned one.
    vec3 paneRadiance = vec3(0.0);
    float paneThrough = 1.0;
    if (hit && !water && isSeenThrough(answer.mOpacity))
    {
        paneThrough = 1.0 - answer.mOpacity;
        paneRadiance = shaded * answer.mOpacity;

        answer.mAsked = ASK_BEHIND;
        RTX_TRACE_AND_SHADE(found, origin, distance + SHADOW_BIAS, direction, EYE_MASK)

        origin = hitObjectGetWorldRayOriginEXT(found);
        direction = hitObjectGetWorldRayDirectionEXT(found);

        hit = hitObjectIsHitEXT(found);
        distance = hitObjectGetRayTMaxEXT(found);
        instance = hitObjectGetInstanceCustomIndexEXT(found);

        shaded = answer.mRadiance;
        bounced = answer.mBounced;
        response = answer.mResponse;
        mirror = answer.mMirror;
        skyShown = answer.mSkyShown;
        water = answer.mWater;
    }

    // **What the surface is, kept apart from what the path did to it.** These two used to be one
    // channel: the albedo was multiplied by every transmittance on the way to the eye, which is what
    // the composite wants back and is not what an upscaler demodulates by. A foggy wall reported an
    // albedo with the fog in it, so Ray Reconstruction divided the light by the wrong number
    // wherever there was weather — which outdoors is nearly everywhere.
    vec3 transmittance = vec3(1.0);

    // Made here and not before the trace: nothing above reads it, and a value defined before a
    // reorder and used after it is exactly what the sources call live state.
    const Cone cone = coneAt(frame.mCamera);

    const bool submerged = waterOver(origin) > 0.0;
    const bool unbounded = waterUnbounded(hit, origin, direction);

    // **The pane over what it stands in front of, before the water and the air.** Both of those are
    // measured over the distance to the surface *behind* the glass, so the pane takes the haze of a
    // path it is only part of the way along — an over-darkening, and the same one `spritesAlong`
    // accepts below for the same reason.
    shaded = shaded * paneThrough + paneRadiance;
    transmittance *= paneThrough;

    // A camera under the surface sees everything through the water in front of it, **the surface
    // included**. What the water's own shader attenuated is each of its own rays over its own
    // stretch — the reflection back down into the water, the refraction through the air above — and
    // the stretch from the eye up to the surface is a different one that nothing else pays. Leaving
    // it out is what made the same column read one way from above and another from below: a ray
    // aimed up from a hundred units down found the surface exactly as bright as one aimed up from
    // ten.
    //
    // Applied to the whole colour rather than to the albedo alone — what the depth took is a
    // property of the path, so it belongs to the modulation and not to the material.
    if (submerged)
    {
        // An escaped ray carries neither of the two numbers a column is measured with: it kept
        // `mFar` for its distance and nought for its cone. What an unbounded one crossed is the
        // whole column, read at the width a cone that far out has — which is wider than any wave, so
        // the shaft march finds no pattern there to resolve.
        const float footprint = hit ? cone.mWidth + cone.mSpread * distance : 0.0;

        const float path = unbounded ? WATER_UNBOUNDED_PATH : distance;
        const float width = unbounded ? cone.mWidth + cone.mSpread * path : footprint;

        const WaterColumn column
            = waterColumn(origin, direction, path, width, randomAt(pixel, STREAM_WATER));

        transmittance *= column.mTransmittance;
        shaded = throughWater(shaded, column);
    }

    // The air in front of all of it. Last, because everything else in the frame is what the fog
    // stands between the eye and — the water's own absorption included, which is a different medium
    // over a different part of the path. A ray that hit nothing carries `mFar`, which the march
    // clamps to the distance past which air stops mattering.
    const vec4 fog = fogAlong(pixel, origin, direction, distance, randomAt(pixel, STREAM_FOG), pixelKey(pixel));
    shaded = shaded * fog.w + fog.xyz;
    transmittance *= fog.w;

    // The particles in front of all of it, each already dimmed by the air between it and the eye —
    // which is why this composites over a frame the fog has finished with rather than before it.
    //
    // What a covering sprite hides is taken off the whole of `shaded`, the fog's own in-scattering
    // included. Exactly right for what is behind the sprite and an over-darkening of the haze in
    // front of it, which is the part of the ray a puff of smoke is nearly always at the end of.
    const SpriteLayer particles = spritesAlong(pixel, origin, direction, distance);

    // Kept because the motion vector below is decided by which of the two terms of the line under
    // this one is the larger, and that line is where the first of them stops existing.
    const vec3 beforeParticles = shaded;

    shaded = shaded * particles.mTransmittance + particles.mRadiance;
    transmittance *= particles.mTransmittance;

    if (COUNT_HITS && hit)
        atomicAdd(hits, 1);

    const ivec2 at = ivec2(pixel);

    // **Coverage rides in the direct channel's alpha**, which every pass after this carries
    // through untouched: it is one everywhere but in a picture that has to say where it stops.
    const float coverage = (frame.mTransparentBackground != 0u && !hit) ? 0.0 : 1.0;
    imageStore(direct, at, vec4(shaded, coverage));

    // **The bounce carries what the path took off it, and the albedo carries only the surface.**
    // The composite still multiplies the two, so the picture is the same product it always was; what
    // moved is which of the two the water and the air are folded into. They belong to the light,
    // which is what they attenuated — and the channel that is left is then the albedo an upscaler
    // asks for.
    //
    // Filtering the bounce with the transmittance already in it averages a quantity that varies as
    // slowly as fog does, which is to say it changes nothing.
    imageStore(indirect, at, vec4(bounced * transmittance, 1.0));
    imageStore(albedo, at, vec4(response.mDiffuse, 1.0));
    imageStore(specular, at, vec4(response.mSpecular, 1.0));
    imageStore(guide, at, vec4(response.mNormal, response.mRoughness));

    // **A sprite that hides nothing still moves something.** Additive blending leaves the
    // transmittance at one by definition, so a flame or a spark shows up only in what it added —
    // and it is exactly as unreprojectable as a raindrop that occludes. Both count.
    const bool sprited = particles.mTransmittance < 1.0 || any(greaterThan(particles.mRadiance, vec3(0.0)));
    imageStore(particleMask, at, vec4(sprited ? 1.0 : 0.0));

    // Which sprite owns this pixel's motion, if any does — the mask below and the vector further
    // down are the same question asked twice, so it is answered once.
    const SpriteClaim claim = spriteClaim(beforeParticles, particles);

    // **What no motion vector here describes, which is far less than what moves.** This says stop
    // accumulating, so everything it names is a pixel reconstructed from one sample — and a mask
    // that names a third of the frame is a third of the frame held at the noise the trace left.
    //
    // Water is not on it. Water is shaded where it is seen and shows what is somewhere else, which
    // is a real problem and is the one `reflectionMotion` answers: the surface has its vector and
    // what it reflects has another, and NGX weighs the two by the specular albedo it was given.
    // Marking it untrustworthy as well would throw away the answer for the sake of the question.
    //
    // What is left is the pixel a sprite reached and did not win: the vector written for it is the
    // surface's, and some share of what the pixel shows is a particle that went somewhere else.
    // Where the sprite *did* win, the vector is the sprite's own and the pixel is described.
    const bool untrusted = sprited && !(claim.mWeight > 0.0);
    imageStore(biasMask, at, vec4(untrusted ? 1.0 : 0.0));

    // **The sky moves too, and only its turn moves it.** `skyMotionOf` says why storing nothing here
    // was a smear across every camera rotation.
    vec2 moved = hit ? motionOf(pixel, origin, direction, distance, instance) : skyMotionOf(pixel, direction);

    // **A pixel a sprite mostly is moves the way that sprite did.** One motion vector is written per
    // pixel and it used to be the surface's whatever stood in front of it, so a raindrop crossing a
    // wall was reprojected as though it were the wall — which is what `particleMask` was reduced to
    // apologising for. `spriteClaim` says which sprite owns the pixel, by either of the two ways a
    // sprite can own one — which covers a flame as well as a raindrop.
    if (claim.mWeight > 0.0)
        moved = spriteMotionOf(pixel, claim);
    imageStore(motion, at, vec4(moved, 0.0, 0.0));

    // **The one surface in this frame that shows something standing somewhere else.** Water is
    // shaded where it is seen, so the vector above describes the surface and not what is in it; this
    // is the other one, and the upscaler weighs the two by the specular albedo it was already given.
    imageStore(reflectionMotion, at, vec4(water ? mirrorMotionOf(pixel, origin, mirror) : vec2(0.0), 0.0, 0.0));

    // **What the display pass has to draw the star field through**, which is everything this frame
    // put between the field and the eye: the sky's own layers in `skyShown`, and the pane, the
    // water, the air and the sprites in the transmittance the light itself was already taken down
    // by. `starsShown` in `bindings.glsl` says why that pass cannot work any of it out for itself.
    imageStore(starsShown, at, vec4(skyShown * transmittance, 1.0));

    // A miss is as far away as anything can be, and the hit object already carries `mFar` for it.
    imageStore(depth, at, vec4(hit ? clipDepth(direction, distance) : 1.0, distance, 0.0, 0.0));
}
