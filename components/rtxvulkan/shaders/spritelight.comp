#version 460

#extension GL_GOOGLE_include_directive : require

// What a sprite's own texture leaves of the light crossing it, baked from its alpha, made where
// the texture is.
//
// **`Rtx::SpriteLightMap`, on the device.** Six-way lighting for a billboard: for every texel and
// each of the four in-plane directions, how much light from that side reaches it through the
// texels between, as a running product of `(1 - a) ^ (1 / N)` over a level `N` texels across —
// written to a texel *before* that texel's own alpha is multiplied in, because what reaches a
// texel is what the ones beyond it let through and not what it lets through itself. The channels
// are light from `+u`, `-u`, `+v` and `-v` in the texture's own coordinates, as `sprites.glsl`
// reads. On the device because the source is uploaded anyway and the bake is read by nothing but
// the trace: made on the host it walked every texel of every level four times on the frame the
// first flame of a cell stood, and it was the one texture reading the cell ring never read ahead.
//
// **One thread a texel and the whole line for each channel**, in the order the host multiplies
// in — from the far edge inward — so the two agree to the last multiply and differ only in `pow`.
// A level's worth of a sprite is a few thousand texels, and a texel's four walks are a few
// hundred multiplies: a scan would save nothing anybody can measure and would sum in another order.

#include "scene.h"
#include "sets.h"
#include "spritelight.h"

#include "lib/pixels.glsl"

layout(local_size_x = SPRITE_LIGHT_WORKGROUP, local_size_y = SPRITE_LIGHT_WORKGROUP) in;

/// The sprite, every level, fetched by texel: the sampler is whichever the array binds.
layout(set = SET_PASS, binding = SPRITE_LIGHT_BIND_SOURCE) uniform sampler2D source;

/// The level of the bake this dispatch writes.
layout(set = SET_PASS, binding = SPRITE_LIGHT_BIND_BAKE, TEXTURE_WRITTEN_FORMAT) uniform writeonly image2D bake;

layout(push_constant, scalar) uniform Push
{
    SpriteLightConstants level;
};

/// What a ray keeps for crossing one texel of alpha `alpha` in a line `count` texels long.
float across(float alpha, uint count)
{
    return pow(1.0 - alpha, 1.0 / float(count));
}

float alphaAt(uint x, uint y)
{
    return texelFetch(source, ivec2(x, y), int(level.mLevel)).a;
}

void main()
{
    const uvec2 texel = gl_GlobalInvocationID.xy;
    if (outsideOf(texel, uvec2(level.mWidth, level.mHeight)))
        return;

    const uint x = texel.x;
    const uint y = texel.y;

    float fromRight = 1.0;
    for (uint at = level.mWidth; at-- > x + 1u;)
        fromRight *= across(alphaAt(at, y), level.mWidth);

    float fromLeft = 1.0;
    for (uint at = 0u; at < x; ++at)
        fromLeft *= across(alphaAt(at, y), level.mWidth);

    float fromBelow = 1.0;
    for (uint at = level.mHeight; at-- > y + 1u;)
        fromBelow *= across(alphaAt(x, at), level.mHeight);

    float fromAbove = 1.0;
    for (uint at = 0u; at < y; ++at)
        fromAbove *= across(alphaAt(x, at), level.mHeight);

    imageStore(bake, ivec2(x, y), vec4(fromRight, fromLeft, fromBelow, fromAbove));
}
