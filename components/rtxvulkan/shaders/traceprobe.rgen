#version 460

#extension GL_EXT_ray_tracing : require
#extension GL_EXT_shader_invocation_reorder : require
#extension GL_EXT_scalar_block_layout : require

// The launch itself, asked of the device directly: every invocation writes where it stood, at the
// place its own launch index names.
//
// **What this proves is the shader binding table and `vkCmdTraceRaysKHR`**, which the trace depends
// on and which nothing else in this renderer would notice being wrong: a table whose one handle
// landed at the wrong offset, or a launch whose grid is not the one that was asked for, draws a
// picture that is missing or garbled rather than one that says what happened. `RtxProbeTest` is the
// same idea for the buffer reads.
//
// **And it reorders, then reads its launch index again.** That is the one thing a reorder must
// leave alone and the one thing that would be silent if it did not: an invocation moves to another
// lane and its launch index moves with it, so a shader that read the index before the call and one
// that reads it after must agree. Both are written here, from either side of the call.

layout(set = 0, binding = 0, scalar) writeonly buffer Launched
{
    uvec2 launched[];
};

void main()
{
    const uvec2 before = gl_LaunchIDEXT.xy;

    hitObjectEXT sorted;
    hitObjectRecordMissEXT(sorted, gl_RayFlagsNoneEXT, 0u, vec3(0.0), 0.0, vec3(0.0, 0.0, 1.0), 1.0);
    reorderThreadEXT(sorted, before.x & 1u, 1);

    const uvec2 after = gl_LaunchIDEXT.xy;

    // Addressed by the index read after the call and holding the one read before it, so a reorder
    // that moved either of them is a slot missed or a slot holding somebody else's index.
    launched[after.y * gl_LaunchSizeEXT.x + after.x] = before;
}
