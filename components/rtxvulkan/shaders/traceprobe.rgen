#version 460

#extension GL_EXT_ray_tracing : require
#extension GL_EXT_shader_invocation_reorder : require
#extension GL_EXT_scalar_block_layout : require

// The launch itself, asked of the device directly: every invocation writes where it stood, at the
// place its own launch index names.
//
// **What this proves is the shader binding table and `vkCmdTraceRaysKHR`**, which the trace depends
// on and which nothing else in this renderer would notice being wrong: a table whose one handle
// landed at the wrong offset, or a launch whose grid is not the one that was asked for, draws a
// picture that is missing or garbled rather than one that says what happened. `RtxProbeTest` is the
// same idea for the buffer reads.
//
// **And it executes the one record its table holds, the way the trace executes what it traced.** A
// hit object naming a record is data until it is executed, and executing one the table does not
// hold loses the device rather than failing validation — so the record is named, executed, and
// its shader's answer is what lets the slot be written at all.

layout(set = 0, binding = 0, scalar) writeonly buffer Launched
{
    uvec2 launched[];
};

layout(location = 0) rayPayloadEXT uint answered;

void main()
{
    const uvec2 before = gl_LaunchIDEXT.xy;

    hitObjectEXT missed;
    hitObjectRecordMissEXT(missed, gl_RayFlagsNoneEXT, 0u, vec3(0.0), 0.0, vec3(0.0, 0.0, 1.0), 1.0);

    answered = 1u;
    hitObjectExecuteShaderEXT(missed, 0);

    const uvec2 after = gl_LaunchIDEXT.xy;

    // Addressed by the index read after the call and holding the one read before it, and only where
    // the miss shader answered: a slot missed is an invocation that never ran, never reached its
    // record, or reached somebody else's.
    if (answered == 0u)
        launched[after.y * gl_LaunchSizeEXT.x + after.x] = before;
}
